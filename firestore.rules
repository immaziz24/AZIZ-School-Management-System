rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // schools/{schoolId}: name, contactEmail, phone and address (strings).
    // schools/{schoolId}/members/{uid}: role (string), active (boolean).
    // Memberships are provisioned by an administrator.
    function isSchoolOwner(schoolId) {
      let path = /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid);
      return exists(path) && get(path).data.active == true && get(path).data.role == 'owner';
    }

    match /schools/{schoolId} {
      allow get: if request.auth != null && isSchoolOwner(schoolId);
      allow update: if request.auth != null && isSchoolOwner(schoolId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'contactEmail', 'phone', 'address'])
        && validProfile(request.resource.data);

      // Staff profiles contain contact and job details only.
      match /members/{uid} {
        allow get: if request.auth != null && request.auth.uid == uid;
      }

      // teacherAssignments/{uid}: className and subject (strings).
      match /teacherAssignments/{uid} {
        function activeTeacher() {
          let path = /databases/$(database)/documents/schools/$(schoolId)/members/$(uid);
          return exists(path) && get(path).data.active == true && get(path).data.role == 'teacher';
        }

        allow get: if request.auth != null && (isSchoolOwner(schoolId)
          || (request.auth.uid == uid && activeTeacher()));
        allow create, update: if request.auth != null && isSchoolOwner(schoolId)
          && activeTeacher() && validAssignment(request.resource.data);
      }

      match /staff/{staffId} {
        allow get, list: if request.auth != null && isSchoolOwner(schoolId);
        allow create, update: if request.auth != null && isSchoolOwner(schoolId)
          && validStaff(request.resource.data);
      }
    }

    function validAssignment(assignment) {
      return assignment.keys().hasAll(['className', 'subject'])
        && assignment.keys().hasOnly(['className', 'subject'])
        && assignment.className is string && assignment.className.size() <= 80
        && assignment.className.matches('.*[^[:space:]].*')
        && assignment.subject is string && assignment.subject.size() <= 80
        && assignment.subject.matches('.*[^[:space:]].*');
    }

    function validStaff(staff) {
      return staff.keys().hasAll(['name', 'position', 'email'])
        && staff.keys().hasOnly(['name', 'position', 'email'])
        && staff.name is string && staff.name.size() <= 120
        && staff.name.matches('.*[^[:space:]].*')
        && staff.position is string && staff.position.size() <= 80
        && staff.position.matches('.*[^[:space:]].*')
        && staff.email is string && staff.email.size() <= 254
        && (staff.email == '' || staff.email.matches('[^@[:space:]]+@[^@[:space:]]+'));
    }

    function validProfile(profile) {
      return profile.name is string && profile.name.size() <= 120
        && profile.name.matches('.*[^[:space:]].*')
        && profile.contactEmail is string && profile.contactEmail.size() <= 254
        && (profile.contactEmail == '' || profile.contactEmail.matches('[^@[:space:]]+@[^@[:space:]]+'))
        && profile.phone is string && profile.phone.size() <= 40
        && profile.address is string && profile.address.size() <= 500;
    }
  }
}
