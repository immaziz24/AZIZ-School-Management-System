        && item.body is string && item.body.size() <= 2000 && item.body.matches('.*[^[:space:]].*')
        && item.audience in ['all', 'teachers', 'families', 'class']
        && (item.audience == 'class'
          ? (item.keys().hasAny(['classId']) && item.classId is string && item.classId.matches('[a-z0-9-]{1,20}'))
