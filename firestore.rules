        && item.details is string && item.details.size() <= 2000 && item.details.matches('.*[^[:space:]].*')
        && item.dueDate is string && item.dueDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && item.createdAt is string && item.createdAt.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && item.createdAt >= '2020-01-01'
