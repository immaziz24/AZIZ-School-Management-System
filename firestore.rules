        && (!item.keys().hasAny(['teacher']) || (item.teacher is string && item.teacher.size() <= 60))
        && (!item.keys().hasAny(['place']) || (item.place is string && item.place.size() <= 60))
        && (!item.keys().hasAny(['note']) || (item.note is string && item.note.size() <= 200));
    }

    function validPayroll(item) {
      return item.keys().hasOnly(['staffUid', 'month', 'basic', 'allowances', 'deductions', 'paidOn', 'note'])
        && item.keys().hasAll(['staffUid', 'month', 'basic', 'allowances', 'deductions'])
        && item.staffUid is string && item.staffUid.size() >= 1 && item.staffUid.size() <= 40
        && item.month is string && item.month.matches('20[0-9]{2}-(0[1-9]|1[0-2])')
        && item.basic is int && item.basic >= 0 && item.basic <= 10000000
        && item.allowances is int && item.allowances >= 0 && item.allowances <= 10000000
        && item.deductions is int && item.deductions >= 0 && item.deductions <= 10000000
        && item.deductions <= item.basic + item.allowances
        && (!item.keys().hasAny(['paidOn']) || (item.paidOn is string && item.paidOn.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
        && (!item.keys().hasAny(['note']) || (item.note is string && item.note.size() <= 200));
    }

    function validMessage(item) {
      return item.keys().hasOnly(['studentId', 'subject', 'body', 'createdAt', 'createdBy', 'reply', 'repliedAt'])
        && item.keys().hasAll(['studentId', 'subject', 'body', 'createdAt', 'createdBy'])
        && item.studentId is string && item.studentId.matches('[a-z0-9-]{1,20}')
        && item.subject is string && item.subject.size() <= 100 && item.subject.matches('.*[^[:space:]].*')
        && item.body is string && item.body.size() <= 1000 && item.body.matches('.*[^[:space:]].*')
        && item.createdAt is string && item.createdAt.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && item.createdAt >= '2020-01-01'
        && item.createdBy is string
        && (!item.keys().hasAny(['reply']) || (item.reply is string && item.reply.size() <= 1000 && item.reply.matches('.*[^[:space:]].*')))
        && (!item.keys().hasAny(['repliedAt']) || (item.repliedAt is string && item.repliedAt.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));
    }

    function optionalText(item, key, max) {
      return !item.keys().hasAny([key]) || (item[key] is string && item[key].size() <= max);
    }

    function validSite(item) {
      return item.keys().hasOnly(['name', 'tagline', 'about', 'vision', 'mission', 'leadership', 'programmes', 'faculty',
          'facilities', 'news', 'phone', 'email', 'address', 'mapUrl'])
        && item.keys().hasAll(['name'])
        && item.name is string && item.name.size() >= 1 && item.name.size() <= 80
        && optionalText(item, 'tagline', 120) && optionalText(item, 'about', 2000) && optionalText(item, 'vision', 500)
        && optionalText(item, 'mission', 500) && optionalText(item, 'leadership', 1000) && optionalText(item, 'programmes', 2000)
        && optionalText(item, 'faculty', 2000) && optionalText(item, 'facilities', 1500) && optionalText(item, 'news', 1500)
        && optionalText(item, 'phone', 30) && optionalText(item, 'email', 100) && optionalText(item, 'address', 200)
        && (!item.keys().hasAny(['mapUrl']) || (item.mapUrl is string && item.mapUrl.size() <= 600
          && item.mapUrl.matches('(https://www\\.google\\.com/maps/embed\\?[^ ]*)?')));
    }

    function validEnquiry(item) {
      return item.keys().hasOnly(['studentName', 'classApplying', 'guardianName', 'phone', 'email', 'message', 'createdAt', 'status', 'note'])
        && item.keys().hasAll(['studentName', 'classApplying', 'guardianName', 'phone', 'createdAt', 'status'])
        && item.studentName is string && item.studentName.size() <= 80 && item.studentName.matches('.*[^[:space:]].*')
        && item.classApplying is string && item.classApplying.size() <= 40 && item.classApplying.matches('.*[^[:space:]].*')
        && item.guardianName is string && item.guardianName.size() <= 80 && item.guardianName.matches('.*[^[:space:]].*')
        && item.phone is string && item.phone.matches('[0-9+() -]{6,20}')
        && optionalText(item, 'email', 100) && optionalText(item, 'message', 500) && optionalText(item, 'note', 300)
        && item.createdAt is string && item.createdAt.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && item.createdAt >= '2020-01-01'
        && item.status in ['new', 'contacted', 'admitted', 'rejected'];
    }

    function validEventReg(item) {
      return item.keys().hasOnly(['eventId', 'eventTitle', 'studentId', 'registeredOn', 'createdBy'])
        && item.keys().hasAll(['eventId', 'eventTitle', 'studentId', 'registeredOn', 'createdBy'])
        && item.eventId is string && item.eventId.matches('[A-Za-z0-9-]{1,30}')
        && item.eventTitle is string && item.eventTitle.size() >= 1 && item.eventTitle.size() <= 100
        && item.studentId is string && item.studentId.matches('[a-z0-9-]{1,20}')
        && item.registeredOn is string && item.registeredOn.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && item.createdBy is string;
    }

    function validSubmission(item) {
      return item.keys().hasOnly(['homeworkId', 'homeworkTitle', 'studentId', 'studentName', 'classId', 'answer', 'submittedOn', 'createdBy', 'feedback', 'feedbackAt'])
        && item.keys().hasAll(['homeworkId', 'homeworkTitle', 'studentId', 'studentName', 'classId', 'answer', 'submittedOn', 'createdBy'])
        && item.homeworkId is string && item.homeworkId.matches('[A-Za-z0-9-]{1,30}')
        && item.homeworkTitle is string && item.homeworkTitle.size() >= 1 && item.homeworkTitle.size() <= 100
        && item.studentId is string && item.studentId.matches('[a-z0-9-]{1,20}')
        && item.studentName is string && item.studentName.size() >= 1 && item.studentName.size() <= 80
        && item.classId is string && item.classId.matches('[a-z0-9-]{1,20}')
        && item.answer is string && item.answer.size() <= 2000 && item.answer.matches('.*[^[:space:]].*')
        && item.submittedOn is string && item.submittedOn.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && item.createdBy is string
        && optionalText(item, 'feedback', 500)
        && (!item.keys().hasAny(['feedbackAt']) || (item.feedbackAt is string && item.feedbackAt.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));
    }

    function validAssessment(item) {
      return item.keys().hasOnly(['classId', 'subjectId', 'subject', 'title', 'date', 'maxMarks', 'createdBy'])
        && item.keys().hasAll(['classId', 'subjectId', 'subject', 'title', 'date', 'maxMarks', 'createdBy'])
        && item.classId is string && item.classId.matches('[a-z0-9-]{1,20}')
        && item.subjectId is string && item.subjectId.matches('[a-z0-9-]{1,30}')
        && item.subject is string && item.subject.size() >= 1 && item.subject.size() <= 40
        && item.title is string && item.title.size() <= 100 && item.title.matches('.*[^[:space:]].*')
        && item.date is string && item.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && item.date >= '2020-01-01'
        && item.maxMarks is int && item.maxMarks >= 1 && item.maxMarks <= 1000
        && item.createdBy is string;
    }

    function validScore(item) {
      return item.keys().hasOnly(['assessmentId', 'assessmentTitle', 'subject', 'subjectId', 'date', 'studentId', 'classId', 'yearId', 'score', 'maxMarks', 'createdBy'])
        && item.keys().hasAll(['assessmentId', 'assessmentTitle', 'subject', 'subjectId', 'date', 'studentId', 'classId', 'yearId', 'score', 'maxMarks', 'createdBy'])
        && item.assessmentId is string && item.assessmentId.matches('[A-Za-z0-9-]{1,30}')
        && item.assessmentTitle is string && item.assessmentTitle.size() >= 1 && item.assessmentTitle.size() <= 100
        && item.subject is string && item.subject.size() >= 1 && item.subject.size() <= 40
        && item.subjectId is string && item.subjectId.matches('[a-z0-9-]{1,30}')
        && item.date is string && item.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && item.studentId is string && item.studentId.matches('[a-z0-9-]{1,20}')
        && item.classId is string && item.classId.matches('[a-z0-9-]{1,20}')
        && item.yearId is string && item.yearId.matches('[a-z0-9-]{1,20}')
        && item.score is int && item.score >= 0 && item.score <= 1000
        && item.maxMarks is int && item.maxMarks >= 1 && item.maxMarks <= 1000
        && item.createdBy is string;
    }

    function validFamilyAccess(item) {
      return item.keys().hasOnly(['studentId', 'relation', 'active', 'extraStudentIds', 'extraClassIds'])
        && item.keys().hasAll(['studentId', 'relation', 'active'])
        && item.studentId is string && item.studentId.matches('[a-z0-9-]{1,20}')
        && item.relation in ['student', 'parent'] && item.active is bool
        && (!item.keys().hasAny(['extraStudentIds']) || (item.extraStudentIds is list && item.extraStudentIds.size() <= 4
          && item.relation == 'parent'))
        && (!item.keys().hasAny(['extraClassIds']) || (item.extraClassIds is list && item.extraClassIds.size() <= 4
          && item.keys().hasAny(['extraStudentIds'])));
    }

    function validExam(item) {
      return item.keys().hasOnly(['yearId', 'classId', 'subjectId', 'examKey', 'name', 'maxMarks', 'status', 'approvedBy', 'published'])
        && item.keys().hasAll(['yearId', 'classId', 'subjectId', 'examKey', 'name', 'maxMarks', 'status'])
        && item.yearId is string && item.yearId.matches('[a-z0-9-]{1,20}')
        && item.classId is string && item.classId.matches('[a-z0-9-]{1,20}')
        && item.subjectId is string && item.subjectId.matches('[a-z0-9-]{1,30}')
        && item.examKey is string && item.examKey.matches('[a-z0-9-]{1,20}')
        && item.name is string && item.name.size() <= 60 && item.name.matches('.*[^[:space:]].*')
        && item.maxMarks is int && item.maxMarks >= 1 && item.maxMarks <= 1000
        && item.status in ['open', 'locked', 'approved']
        && ((item.status == 'approved')
          ? (item.keys().hasAll(['approvedBy']) && item.approvedBy == request.auth.uid)
          : !item.keys().hasAny(['approvedBy']))
        && (!item.keys().hasAny(['published']) || (item.status == 'approved' && item.published == true));
    }

    function validStudentRecord(student) {
      return student.keys().hasOnly(['admissionNo', 'name', 'guardianName', 'guardianPhone', 'status'])
        && student.keys().hasAll(['admissionNo', 'name', 'guardianName', 'guardianPhone', 'status'])
        && student.admissionNo is string && student.admissionNo.matches('[A-Za-z0-9-]{1,20}')
        && student.name is string && student.name.size() <= 120 && student.name.matches('.*[^[:space:]].*')
        && student.guardianName is string && student.guardianName.size() <= 120
        && student.guardianName.matches('.*[^[:space:]].*')
        && student.guardianPhone is string && student.guardianPhone.matches('[0-9+() -]{0,20}')
        && student.status in ['active', 'inactive'];
    }

    function validEnrollment(item) {
      return item.keys().hasOnly(['yearId', 'studentId', 'classId', 'sectionId', 'rollNo'])
        && item.keys().hasAll(['yearId', 'studentId', 'classId', 'sectionId', 'rollNo'])
        && item.yearId is string && item.yearId.matches('[a-z0-9-]{1,20}')
        && item.studentId is string && item.studentId.matches('[a-z0-9-]{1,20}')
        && item.classId is string && item.classId.matches('[a-z0-9-]{1,20}')
        && item.sectionId is string && item.sectionId.matches('[a-z0-9-]{1,31}')
        && item.rollNo is int && item.rollNo >= 1 && item.rollNo <= 999;
    }

    function validRollKey(item) {
      return item.keys().hasOnly(['yearId', 'sectionId', 'rollNo', 'studentId'])
        && item.keys().hasAll(['yearId', 'sectionId', 'rollNo', 'studentId'])
        && item.yearId is string && item.yearId.matches('[a-z0-9-]{1,20}')
        && item.sectionId is string && item.sectionId.matches('[a-z0-9-]{1,31}')
        && item.studentId is string && item.studentId.matches('[a-z0-9-]{1,20}')
        && item.rollNo is int && item.rollNo >= 1 && item.rollNo <= 999;
    }

    function validStaff(staff) {
      return staff.keys().hasAll(['name', 'position', 'email'])
        && staff.keys().hasOnly(['name', 'position', 'email'])
        && staff.name is string && staff.name.size() <= 120
        && staff.name.matches('.*[^[:space:]].*')
        && staff.position is string && staff.position.size() <= 80
        && staff.position.matches('.*[^[:space:]].*')
        && staff.email is string && staff.email.size() <= 254
        && (staff.email == '' || staff.email.matches('[^@[:space:]]+@[^@[:space:]]+'));
    }

    function validProfile(profile) {
      return profile.name is string && profile.name.size() <= 120
        && profile.name.matches('.*[^[:space:]].*')
        && profile.contactEmail is string && profile.contactEmail.size() <= 254
        && (profile.contactEmail == '' || profile.contactEmail.matches('[^@[:space:]]+@[^@[:space:]]+'))
        && profile.phone is string && profile.phone.size() <= 40
        && profile.address is string && profile.address.size() <= 500;
    }
  }
}
