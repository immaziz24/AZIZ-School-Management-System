        && item.staffUid is string && item.staffUid.size() >= 1 && item.staffUid.size() <= 128
        && item.fromDate is string && item.fromDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && item.fromDate >= '2020-01-01'
        && item.toDate is string && item.toDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && item.toDate >= item.fromDate
        && item.reason is string && item.reason.size() <= 200 && item.reason.matches('.*[^[:space:]].*')
