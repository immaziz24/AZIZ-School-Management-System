        && item.keys().hasAll(['studentId', 'yearId', 'amount', 'date', 'method', 'receiptNo', 'receivedBy'])
        && item.studentId is string && item.studentId.matches('[a-z0-9-]{1,20}')
        && item.yearId is string && item.yearId.matches('[a-z0-9-]{1,20}')
        && item.amount is int && item.amount >= 1 && item.amount <= 10000000
