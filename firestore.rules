rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // schools/{schoolId}: name, contactEmail, phone and address (strings).
    // schools/{schoolId}/members/{uid}: role (string), active (boolean).
    // Memberships are provisioned by an administrator.
    // Platform administrators are listed in platformAdmins/{uid}. The documents are created in the
    // Firebase console only; the rules give nobody a way to add one.
    function isPlatformAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    // A school whose billing record says suspended or cancelled is read-only for its owner.
    function schoolSuspended(schoolId) {
      let billing = /databases/$(database)/documents/schools/$(schoolId)/billing/main;
      return exists(billing) && billingBlocked(get(billing).data);
    }

    // A school is read-only when it is suspended or cancelled, or when its free trial ended and the grace
    // period (graceDays, none if unset) has run out. The platform administrator can reactivate it any time.
    function billingBlocked(b) {
      return b.status in ['suspended', 'cancelled']
        || (b.status == 'trial' && b.keys().hasAny(['trialEnds'])
          && request.time > b.trialEnds + duration.value(b.get('graceDays', 0), 'd'));
    }

    // Plan limits. usageKey is 'students' or 'staff'; the school may add another only while its last
    // recorded count (usage/main) is below the plan limit. No plan, no limit set or no count yet means no cap.
    function withinLimit(schoolId, usageKey, limitKey) {
      let billing = /databases/$(database)/documents/schools/$(schoolId)/billing/main;
      let usage = /databases/$(database)/documents/schools/$(schoolId)/usage/main;
      return !exists(billing) || !get(billing).data.keys().hasAny([limitKey]) || !exists(usage)
        || get(usage).data[usageKey] < get(billing).data[limitKey];
    }

    // Storage plan limit. Older usage records have no storageMb, which counts as nothing used.
    function withinStorage(schoolId) {
      let billing = /databases/$(database)/documents/schools/$(schoolId)/billing/main;
      let usage = /databases/$(database)/documents/schools/$(schoolId)/usage/main;
      return !exists(billing) || !get(billing).data.keys().hasAny(['storageMb']) || !exists(usage)
        || get(usage).data.get('storageMb', 0) < get(billing).data.storageMb;
    }

    function isOwnerRole(schoolId) {
      let path = /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid);
      return exists(path) && get(path).data.active == true && get(path).data.role == 'owner';
    }

    function isSchoolOwner(schoolId) {
      return isOwnerRole(schoolId) && !schoolSuspended(schoolId);
    }

    // The people who work in the school's owner and principal screens. Used by the few rules that let them WRITE.
    function isStaffViewer(schoolId) {
      let path = /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid);
      return exists(path) && get(path).data.active == true && get(path).data.role in ['owner', 'principal'];
    }

    // Super administrator access (Batch 76). The platform administrator reads a school's records only while an unexpired access grant
    // exists: platformGrants/{uid}_{schoolId}_{tier}. 'standard' lasts up to 60 minutes. 'sensitive' (medical, identity, selfies, payroll,
    // private family records) lasts up to 15 minutes and needs recent MFA once the platform switch requireMfa is on. Every grant is created
    // together with an audit entry in platformAudit, and the rules refuse a grant without one.
    function hasGrant(schoolId, tier) {
      let grant = /databases/$(database)/documents/platformGrants/$(request.auth.uid + '_' + schoolId + '_' + tier);
      return isPlatformAdmin() && exists(grant) && get(grant).data.expiresAt > request.time;
    }
    function hasAccess(schoolId) { return hasGrant(schoolId, 'standard') || hasGrant(schoolId, 'sensitive'); }

    // Everyone who may LOOK at the school's ordinary records: its owner, its principal and a super administrator holding a grant.
    function isSchoolViewer(schoolId) {
      return isStaffViewer(schoolId) || hasAccess(schoolId);
    }

    // Sensitive records: owner, principal, or a super administrator with a short sensitive grant.
    function isSensitiveViewer(schoolId) {
      return isStaffViewer(schoolId) || hasGrant(schoolId, 'sensitive');
    }

    // When the platform switch requireMfa is on, sensitive grants need a second-factor sign-in no older than one hour.
    function mfaOk() {
      let cfg = /databases/$(database)/documents/platformConfig/security;
      return !(exists(cfg) && get(cfg).data.get('requireMfa', false) == true)
        || (request.auth.token.firebase.get('sign_in_second_factor', '') != ''
          && request.auth.token.auth_time * 1000 > request.time.toMillis() - 3600000);
    }

    // The fee office login. It reads the students, classes, years and fees and records payments; it cannot
    // void a payment, change fees or students, or read anything else.
    function isFeeStaff(schoolId) {
      let path = /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid);
      return exists(path) && get(path).data.active == true && get(path).data.role == 'accountant' && !schoolSuspended(schoolId);
    }

    // A principal who is switched on may decide leave requests, post notices and write the activity log.
    function isActivePrincipal(schoolId) {
      return isSchoolPrincipal(schoolId) && !schoolSuspended(schoolId);
    }

    function isSchoolPrincipal(schoolId) {
      let path = /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid);
      return exists(path) && get(path).data.active == true && get(path).data.role == 'principal';
    }

    // Principal switches. settings/principalAccess holds three on/off areas the owner controls for the
    // principal login: payroll (default off), fees and admissions (default on, as before).
    function principalAllows(schoolId, area, fallback) {
      let path = /databases/$(database)/documents/schools/$(schoolId)/settings/principalAccess;
      return isSchoolPrincipal(schoolId) && (exists(path) ? get(path).data.get(area, fallback) == true : fallback);
    }

    // Platform administration. platformAdmins/{uid} documents exist only if created in the console.
    match /platformAdmins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    // Server job results (feature 092). platformJobs/{id}: the nightly backup, fee reminder and health check results. Written only by
    // the server; the platform administrator reads them.
    match /platformJobs/{jobId} {
      allow get, list: if request.auth != null && isPlatformAdmin();
      allow write: if false;
    }

    // Custom domains (067). domainMap/{hostname}: schoolId, verifiedOn. Written only by the platform administrator
    // when a school's domain is marked verified. Anyone may look up one hostname (the public school page does this
    // to find out which school a custom address belongs to); nobody may list them all.
    match /domainMap/{host} {
      allow get: if host.matches('[a-z0-9]([a-z0-9.-]{0,98}[a-z0-9])?[.][a-z]{2,20}');
      allow create: if isPlatformAdmin() && host.matches('[a-z0-9]([a-z0-9.-]{0,98}[a-z0-9])?[.][a-z]{2,20}') && validDomainMap(request.resource.data)
        && exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId));
      allow update: if isPlatformAdmin() && host.matches('[a-z0-9]([a-z0-9.-]{0,98}[a-z0-9])?[.][a-z]{2,20}') && validDomainMap(request.resource.data)
        && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if isPlatformAdmin();
    }

    // platformConfig/flags: feature switches the platform administrator controls. Any signed-in user reads.
    match /platformConfig/{docId} {
      allow get: if request.auth != null && docId in ['flags', 'templates'];
      // platformConfig/marketplace: extra colour themes the platform administrator publishes. Anyone may read it, because the public school page applies them.
      allow get: if docId == 'marketplace';
      allow create, update: if isPlatformAdmin() && docId == 'marketplace' && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 12;
      allow create, update: if isPlatformAdmin() && docId == 'flags';
      // platformConfig/templates: the newest school-page template version and what changed in it.
      allow create, update: if isPlatformAdmin() && docId == 'templates' && validTemplateConfig(request.resource.data);
    }

    // platformConfig/security: the platform switch requireMfa (true or false). Turn it on only after Authentication is upgraded to Identity Platform
    // and the administrator has enrolled a second factor.
    match /platformConfig/{docId} {
      allow get: if isPlatformAdmin() && docId == 'security';
      allow create, update: if isPlatformAdmin() && docId == 'security' && request.resource.data.keys().hasOnly(['requireMfa'])
        && request.resource.data.requireMfa is bool;
    }

    // platformAudit/{id}: the permanent record of what the platform administrator did. Written once, never changed or deleted by anyone.
    // Fields: actor (uid), actorEmail, action, schoolId, reason, detail (before and after, text), at (server time).
    match /platformAudit/{auditId} {
      allow get, list: if isPlatformAdmin();
      allow create: if isPlatformAdmin() && auditId.matches('A-[A-Za-z0-9-]{4,40}') && validAudit(request.resource.data)
        && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // platformGrants/{uid}_{schoolId}_{tier}: a short, school-scoped access pass. See hasGrant. Created with its audit entry (auditId) in one batch.
    match /platformGrants/{grantId} {
      allow get, list: if isPlatformAdmin();
      allow create, update: if isPlatformAdmin() && validGrant(request.resource.data)
        && grantId == request.auth.uid + '_' + request.resource.data.schoolId + '_' + request.resource.data.tier
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(request.resource.data.tier == 'sensitive' ? 15 : 60, 'm')
        && (request.resource.data.tier == 'standard' || mfaOk())
        && existsAfter(/databases/$(database)/documents/platformAudit/$(request.resource.data.auditId));
      allow delete: if isPlatformAdmin() && grantId.matches(request.auth.uid + '_.*');
    }

    // plans/{planId}: the plan catalogue. Signed-in users read it; only the platform administrator writes it, and every change comes with a
    // planHistory entry (historyId) in the same batch.
    match /plans/{planId} {
      allow get, list: if request.auth != null;
      allow create, update: if isPlatformAdmin() && planId.matches('[a-z][a-z0-9-]{1,29}') && validPlan(request.resource.data)
        && existsAfter(/databases/$(database)/documents/planHistory/$(request.resource.data.historyId));
      allow delete: if false;
    }
    match /planHistory/{historyId} {
      allow get, list: if isPlatformAdmin();
      allow create: if isPlatformAdmin() && historyId.matches('H-[A-Za-z0-9-]{4,40}') && validPlanHistory(request.resource.data)
        && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // loginHistory/{uid}_{13 digits}: one entry per sign-in session, written by the user. Only the platform administrator reads them.
    match /loginHistory/{loginId} {
      allow get, list: if isPlatformAdmin();
      allow create: if request.auth != null && loginId.matches(request.auth.uid + '_[0-9]{13}')
        && request.resource.data.keys().hasOnly(['uid', 'email', 'at', 'agent'])
        && request.resource.data.keys().hasAll(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.at == request.time
        && optText(request.resource.data, 'email', 120) && optText(request.resource.data, 'agent', 160);
      allow update, delete: if false;
    }

    // platformMessages/{id}: the master record of each announcement or notice that was sent, and to which schools. Platform administrator only,
    // written once, with its audit entry in the same batch.
    match /platformMessages/{messageId} {
      allow get, list: if isPlatformAdmin();
      allow create: if isPlatformAdmin() && messageId.matches('M-[A-Za-z0-9-]{4,40}') && validMessageLog(request.resource.data)
        && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
        && existsAfter(/databases/$(database)/documents/platformAudit/$(request.resource.data.auditId));
      allow update, delete: if false;
    }

    // platformDrills/{id}: disaster-recovery drill log. Platform administrators only.
    match /platformDrills/{drillId} {
      allow get, list: if isPlatformAdmin();
      allow create, update: if isPlatformAdmin() && drillId.matches('[A-Za-z0-9-]{1,30}') && validDrill(request.resource.data);
      allow delete: if isPlatformAdmin();
    }

    // supportTickets/{id}: schoolId, subject, body, status open/answered/closed, createdBy, createdOn, optional reply.
    // A school owner raises tickets for the own school; the platform administrator reads and answers them.
    match /supportTickets/{ticketId} {
      allow get, list: if request.auth != null && (isPlatformAdmin() || isSchoolViewer(resource.data.schoolId));
      allow create: if request.auth != null && isSchoolOwner(request.resource.data.schoolId)
        && ticketId.matches('[A-Za-z0-9-]{1,30}') && validSupportTicket(request.resource.data)
        && request.resource.data.status == 'open' && request.resource.data.createdBy == request.auth.uid
        && !request.resource.data.keys().hasAny(['reply']);
      allow update: if isPlatformAdmin() && validSupportTicket(request.resource.data)
        && request.resource.data.schoolId == resource.data.schoolId;
    }

    // Extra storage requests (features 127, 157). storageRequests/{id}: the owner asks for more storage space (mb); the platform
    // administrator approves or rejects it once and, on approval, raises the school's storage limit in billing/main.
    match /storageRequests/{reqId} {
      allow get, list: if request.auth != null && (isPlatformAdmin() || isSchoolViewer(resource.data.schoolId));
      allow create: if request.auth != null && isSchoolOwner(request.resource.data.schoolId)
        && reqId.matches('SR-[A-Za-z0-9-]{1,27}') && validStorageRequest(request.resource.data)
        && request.resource.data.status == 'pending' && request.resource.data.createdBy == request.auth.uid
        && !request.resource.data.keys().hasAny(['decidedOn', 'reply']);
      allow update: if isPlatformAdmin() && validStorageRequest(request.resource.data)
        && resource.data.status == 'pending' && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedOn', 'reply']);
      allow delete: if false;
    }

    // invites/{id}: schoolId, email, role, status pending/accepted/revoked, createdBy. The owner invites a
    // person by email; that person, signed in with a verified address, accepts it and becomes a member.
    match /invites/{inviteId} {
      allow get, list: if request.auth != null && isSchoolViewer(resource.data.schoolId);
      allow get, list: if isPlatformAdmin() && resource.data.role == 'owner';
      allow create: if isPlatformAdmin() && inviteId.matches('OW-[A-Za-z0-9-]{1,27}') && validInvite(request.resource.data)
        && request.resource.data.role == 'owner' && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/schools/$(request.resource.data.schoolId));
      allow get, list: if request.auth != null && request.auth.token.email_verified == true
        && resource.data.email == request.auth.token.email.lower();
      allow create: if request.auth != null && isSchoolOwner(request.resource.data.schoolId)
        && withinLimit(request.resource.data.schoolId, 'staff', 'staffLimit')
        && inviteId.matches('[A-Za-z0-9-]{1,30}') && validInvite(request.resource.data)
        && request.resource.data.role != 'owner'
        && request.resource.data.status == 'pending' && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null && validInvite(request.resource.data)
        && request.resource.data.schoolId == resource.data.schoolId && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role && request.resource.data.createdBy == resource.data.createdBy
        && ((isSchoolOwner(resource.data.schoolId) && resource.data.status == 'pending' && request.resource.data.status == 'revoked')
          || (isPlatformAdmin() && resource.data.role == 'owner' && resource.data.status == 'pending' && request.resource.data.status == 'revoked')
          || (request.auth.token.email_verified == true && resource.data.email == request.auth.token.email.lower()
            && resource.data.status == 'pending' && request.resource.data.status == 'accepted'));
    }

    match /schools/{schoolId} {
      allow get: if request.auth != null && (isSchoolViewer(schoolId) || isFeeStaff(schoolId) || isPlatformAdmin());
      allow list: if isPlatformAdmin();
      // Self-service signup (features 065, 099). The signed-in user creates the school, becomes its owner and
      // gets a trial billing record in the same batch. A school ID is a lowercase slug and cannot be reused.
      allow create: if request.auth != null && validNewSchool(request.resource.data)
        && schoolId.matches('[a-z][a-z0-9-]{2,29}') && !(schoolId in ['www', 'admin', 'api', 'app', 'platform', 'school', 'aziz', 'public', 'support', 'demo'])
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if ownerAuth(schoolId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'contactEmail', 'phone', 'address'])
        && validProfile(request.resource.data);
      // Super administrator: registers a school, edits its profile and archives it (archived true plus billing cancelled).
      allow create: if isPlatformAdmin() && validNewSchool(request.resource.data)
        && schoolId.matches('[a-z][a-z0-9-]{2,29}') && !(schoolId in ['www', 'admin', 'api', 'app', 'platform', 'school', 'aziz', 'public', 'support', 'demo'])
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isPlatformAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'contactEmail', 'phone', 'address', 'archived', 'archivedOn'])
        && validProfile(request.resource.data)
        && (!request.resource.data.keys().hasAny(['archived']) || request.resource.data.archived is bool)
        && optText(request.resource.data, 'archivedOn', 10);

      // Staff profiles contain contact and job details only.
      match /members/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || isSchoolViewer(schoolId));
        allow list: if viewerAuth(schoolId);
        // The platform administrator reads and switches the owner records of every school without a grant (they hold no private data).
        allow get, list: if isPlatformAdmin() && resource.data.role == 'owner';
        allow update: if isPlatformAdmin() && resource.data.role == 'owner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
          && request.resource.data.active is bool;
        // The signup user becomes the owner of the school created in the same batch.
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['role', 'active'])
          && request.resource.data.role == 'owner' && request.resource.data.active == true
          && !exists(/databases/$(database)/documents/schools/$(schoolId))
          && getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.createdBy == uid;
        // An accepted invitation makes the invited person a member with the invited role.
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['role', 'active', 'inviteId'])
          && request.resource.data.active == true && request.resource.data.role in ['teacher', 'principal', 'owner', 'accountant']
          && request.resource.data.inviteId is string && request.resource.data.inviteId.matches('[A-Za-z0-9-]{1,30}')
          && request.auth.token.email_verified == true
          && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.status == 'pending'
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.status == 'accepted'
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.schoolId == schoolId
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.role == request.resource.data.role
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.email == request.auth.token.email.lower();
        // The owner switches another member on or off. The role never changes here.
        allow update: if ownerAuth(schoolId) && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
          && request.resource.data.active is bool;
      }

      // teacherAssignments/{uid}: className and subject (strings).
      match /teacherAssignments/{uid} {
        function activeTeacher() {
          let path = /databases/$(database)/documents/schools/$(schoolId)/members/$(uid);
          return exists(path) && get(path).data.active == true && get(path).data.role == 'teacher';
        }

        allow get: if request.auth != null && (isSchoolViewer(schoolId)
          || (request.auth.uid == uid && activeTeacher()));
        // An ID-based assignment must link a subject that is taught in the class, and its
        // display names must match those records.
        function idsMatchRecords(assignment) {
          return !assignment.keys().hasAll(['classId', 'subjectId'])
            || (exists(/databases/$(database)/documents/schools/$(schoolId)/classSubjects/$(assignment.classId + '_' + assignment.subjectId))
              && get(/databases/$(database)/documents/schools/$(schoolId)/classes/$(assignment.classId)).data.name == assignment.className
              && get(/databases/$(database)/documents/schools/$(schoolId)/subjects/$(assignment.subjectId)).data.name == assignment.subject);
        }

        allow create, update: if ownerAuth(schoolId)
          && activeTeacher() && validAssignment(request.resource.data)
          && idsMatchRecords(request.resource.data);
      }

      match /staff/{staffId} {
        allow get, list: if viewerAuth(schoolId);
        allow create: if ownerAuth(schoolId) && withinLimit(schoolId, 'staff', 'staffLimit')
          && validStaff(request.resource.data);
        allow update: if ownerAuth(schoolId)
          && validStaff(request.resource.data);
      }

      // Teacher helpers (feature 042/043). A teacher's assignment may carry classId and
      // subjectId; only those ID-based assignments unlock the exam marks screen.
      function isActiveTeacher() {
        let member = /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid);
        return exists(member) && get(member).data.active == true && get(member).data.role == 'teacher';
      }
      function teacherClassId() {
        let path = /databases/$(database)/documents/schools/$(schoolId)/teacherAssignments/$(request.auth.uid);
        return exists(path) && get(path).data.keys().hasAll(['classId', 'subjectId']) ? get(path).data.classId : '';
      }
      function teacherSubjectId() {
        let path = /databases/$(database)/documents/schools/$(schoolId)/teacherAssignments/$(request.auth.uid);
        return exists(path) && get(path).data.keys().hasAll(['classId', 'subjectId']) ? get(path).data.subjectId : '';
      }
      function teachesClass(classId) {
        return request.auth != null && isActiveTeacher() && teacherClassId() != '' && teacherClassId() == classId;
      }
      function teachesExam(exam) {
        return teachesClass(exam.classId) && teacherSubjectId() == exam.subjectId;
      }
      function markAllowed(mark) {
        let exam = get(/databases/$(database)/documents/schools/$(schoolId)/exams/$(mark.examId)).data;
        let enrollmentPath = /databases/$(database)/documents/schools/$(schoolId)/enrollments/$(mark.yearId + '_' + mark.studentId);
        return exam.status == 'open'
          && exam.yearId == mark.yearId && exam.classId == mark.classId && exam.subjectId == mark.subjectId
          && exam.maxMarks == mark.maxMarks && mark.score <= exam.maxMarks
          && teachesExam(exam) && openYear(exam.yearId)
          && exists(enrollmentPath) && get(enrollmentPath).data.classId == exam.classId;
      }

      // Class teacher. classTeachers/{classId}: teacherUid. One class teacher per
      // class, set by the owner. The class teacher marks daily attendance for that class and
      // can read the class's placements and sections. A class teacher need not teach a subject.
      function classTeacherOf(classId) {
        return request.auth != null && isActiveTeacher()
          && exists(/databases/$(database)/documents/schools/$(schoolId)/classTeachers/$(classId))
          && get(/databases/$(database)/documents/schools/$(schoolId)/classTeachers/$(classId)).data.teacherUid == request.auth.uid;
      }
      function classTeacherOfStudent(studentId) {
        let settings = /databases/$(database)/documents/schools/$(schoolId)/settings/academic;
        let enrollment = /databases/$(database)/documents/schools/$(schoolId)/enrollments/$(get(settings).data.activeYearId + '_' + studentId);
        return exists(settings) && exists(enrollment) && classTeacherOf(get(enrollment).data.classId);
      }
      function activeTeacherMember(uid) {
        let member = /databases/$(database)/documents/schools/$(schoolId)/members/$(uid);
        return exists(member) && get(member).data.active == true && get(member).data.role == 'teacher';
      }
      // A daily attendance mark needs: the signed-in class teacher, an open year, a date inside
      // that year and no later than tomorrow (UTC), and a student placed in the class that year.
      function attendanceAllowed(item) {
        let year = /databases/$(database)/documents/schools/$(schoolId)/academicYears/$(item.yearId);
        let enrollment = /databases/$(database)/documents/schools/$(schoolId)/enrollments/$(item.yearId + '_' + item.studentId);
        return classTeacherOf(item.classId)
          && exists(year) && get(year).data.status in ['draft', 'active']
          && get(year).data.startDate <= item.date && item.date <= get(year).data.endDate
          && item.date <= latestAttendanceDate()
          && exists(enrollment) && get(enrollment).data.classId == item.classId;
      }

      match /classTeachers/{classId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId)
          || (isActiveTeacher() && resource.data.teacherUid == request.auth.uid));
        allow create, update: if ownerAuth(schoolId)
          && classId.matches('[a-z0-9-]{1,20}') && validClassTeacher(request.resource.data)
          && exists(/databases/$(database)/documents/schools/$(schoolId)/classes/$(classId))
          && activeTeacherMember(request.resource.data.teacherUid);
      }

      // Daily attendance. attendance/{date}_{classId}_{studentId}: yearId, classId,
      // studentId, date (YYYY-MM-DD), status (present, absent or late), markedBy. Only the class
      // teacher writes, and may correct a mark at any time while the year is open. The owner
      // reads and reviews every mark. A linked student or parent reads only that student's marks
      // (query by studentId). Records are never deleted.
      match /attendance/{attendanceId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || classTeacherOf(resource.data.classId)
          || familyOwns(resource.data.studentId));
        allow create: if request.auth != null && validAttendance(request.resource.data)
          && request.resource.data.markedBy == request.auth.uid
          && attendanceId == request.resource.data.date + '_' + request.resource.data.classId
            + '_' + request.resource.data.studentId
          && attendanceAllowed(request.resource.data);
        allow update: if request.auth != null && validAttendance(request.resource.data)
          && request.resource.data.markedBy == request.auth.uid
          && request.resource.data.yearId == resource.data.yearId
          && attendanceId == request.resource.data.date + '_' + request.resource.data.classId
            + '_' + request.resource.data.studentId
          && attendanceAllowed(request.resource.data);
      }

      // Staff attendance. staffAttendance/{date}_{staffUid}: staffUid, date (YYYY-MM-DD), status
      // (present, absent, late or leave), markedBy. Only the owner marks and corrects it, for an
      // active teacher, on any date up to tomorrow (UTC). A teacher reads only their own marks
      // (query by staffUid). Records are never deleted.
      match /staffAttendance/{recordId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId)
          || (resource.data.staffUid == request.auth.uid && isActiveTeacher()));
        allow create: if ownerAuth(schoolId)
          && validStaffAttendance(request.resource.data)
          && request.resource.data.markedBy == request.auth.uid
          && recordId == request.resource.data.date + '_' + request.resource.data.staffUid
          && request.resource.data.date <= latestAttendanceDate()
          && activeTeacherMember(request.resource.data.staffUid);
        allow update: if ownerAuth(schoolId)
          && validStaffAttendance(request.resource.data)
          && request.resource.data.markedBy == request.auth.uid
          && recordId == request.resource.data.date + '_' + request.resource.data.staffUid
          && request.resource.data.date <= latestAttendanceDate()
          && request.resource.data.staffUid == resource.data.staffUid
          && activeTeacherMember(request.resource.data.staffUid);
      }

      // Leave requests. leaveRequests/{staffUid}_{fromDate}: staffUid, fromDate, toDate (YYYY-MM-DD),
      // reason (text), status (pending, approved or rejected), and decidedBy once decided. An
      // active teacher creates their own pending request. Only the owner decides one, and only
      // once. A teacher reads only their own requests (query by staffUid). Never deleted.
      match /leaveRequests/{requestId} {
        allow get, list: if request.auth != null && (isSensitiveViewer(schoolId)
          || (resource.data.staffUid == request.auth.uid && isActiveTeacher()));
        allow create: if request.auth != null && isActiveTeacher()
          && validLeaveRequest(request.resource.data)
          && request.resource.data.status == 'pending'
          && !request.resource.data.keys().hasAny(['decidedBy'])
          && request.resource.data.staffUid == request.auth.uid
          && requestId == request.resource.data.staffUid + '_' + request.resource.data.fromDate;
        allow update: if request.auth != null && (isSchoolOwner(schoolId) || isActivePrincipal(schoolId))
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.decidedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy'])
          && validLeaveRequest(request.resource.data);
      }

      // Student leave. studentLeaves/{studentId}_{fromDate}: studentId, studentName, classId, fromDate,
      // toDate (YYYY-MM-DD), reason (text), status (pending, approved or rejected), requestedBy (the
      // student or parent login), and decidedBy and decisionNote once decided. A linked student or
      // parent creates a pending request for their own student only, and the classId must be the class
      // the student is placed in this year. The class teacher of that class decides it, once; the owner
      // or an active principal can also read and decide. Family accounts read only their own student's
      // requests (query by studentId). Never deleted.
      match /studentLeaves/{leaveId} {
        allow get, list: if request.auth != null && (isSensitiveViewer(schoolId)
          || classTeacherOf(resource.data.classId)
          || familyOwns(resource.data.studentId));
        allow create: if request.auth != null && familyOwns(request.resource.data.studentId)
          && validStudentLeave(request.resource.data)
          && request.resource.data.status == 'pending'
          && !request.resource.data.keys().hasAny(['decidedBy', 'decisionNote'])
          && request.resource.data.requestedBy == request.auth.uid
          && leaveId == request.resource.data.studentId + '_' + request.resource.data.fromDate
          && exists(/databases/$(database)/documents/schools/$(schoolId)/settings/academic)
          && get(/databases/$(database)/documents/schools/$(schoolId)/enrollments/$(get(/databases/$(database)/documents/schools/$(schoolId)/settings/academic).data.activeYearId + '_' + request.resource.data.studentId)).data.classId
            == request.resource.data.classId;
        allow update: if request.auth != null
          && (isSchoolOwner(schoolId) || isActivePrincipal(schoolId) || classTeacherOf(resource.data.classId))
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.decidedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decisionNote'])
          && validStudentLeave(request.resource.data);
      }

      // Fees. feeStructures/{yearId}_{classId}_{head}: yearId, classId, head (key), name, amount
      // (whole rupees). The owner sets and removes them. A linked student or parent account can read
      // them. payments/{receiptNo}: studentId, yearId, amount, date, method, receiptNo, receivedBy,
      // voided (optional). The owner records payments. A payment is never edited or deleted; a
      // mistake is voided once. Family accounts read only their own student's payments. Teachers
      // read neither.
      match /feeStructures/{feeId} {
        allow get, list: if request.auth != null && ((isOwnerRole(schoolId) || hasAccess(schoolId) || principalAllows(schoolId, 'fees', true) || isFeeStaff(schoolId)) || familyActive());
        allow create, update: if ownerAuth(schoolId)
          && validFeeStructure(request.resource.data)
          && feeId == request.resource.data.yearId + '_' + request.resource.data.classId + '_' + request.resource.data.head
          && exists(/databases/$(database)/documents/schools/$(schoolId)/academicYears/$(request.resource.data.yearId))
          && classExists(schoolId, request.resource.data.classId);
        allow delete: if ownerAuth(schoolId);
      }

      match /payments/{paymentId} {
        allow get, list: if request.auth != null && ((isOwnerRole(schoolId) || hasAccess(schoolId) || principalAllows(schoolId, 'fees', true) || isFeeStaff(schoolId)) || familyOwns(resource.data.studentId));
        allow create: if request.auth != null && (isSchoolOwner(schoolId) || isFeeStaff(schoolId))
          && validPayment(request.resource.data)
          && !request.resource.data.keys().hasAny(['voided'])
          && request.resource.data.receivedBy == request.auth.uid
          && paymentId == request.resource.data.receiptNo
          && request.resource.data.date <= latestAttendanceDate()
          && studentExists(schoolId, request.resource.data.studentId)
          && exists(/databases/$(database)/documents/schools/$(schoolId)/academicYears/$(request.resource.data.yearId));
        allow update: if ownerAuth(schoolId)
          && !resource.data.keys().hasAny(['voided'])
          && request.resource.data.voided == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided'])
          && validPayment(request.resource.data);
      }

      function studentInClass(studentId, classId) {
        let settings = /databases/$(database)/documents/schools/$(schoolId)/settings/academic;
        return exists(settings)
          && get(/databases/$(database)/documents/schools/$(schoolId)/enrollments/$(get(settings).data.activeYearId + '_' + studentId)).data.classId == classId;
      }
      function scoreAllowed(score) {
        let assessment = get(/databases/$(database)/documents/schools/$(schoolId)/assessments/$(score.assessmentId)).data;
        let enrollmentPath = /databases/$(database)/documents/schools/$(schoolId)/enrollments/$(score.yearId + '_' + score.studentId);
        return assessment.classId == score.classId && assessment.subjectId == score.subjectId
          && assessment.maxMarks == score.maxMarks && assessment.title == score.assessmentTitle
          && assessment.date == score.date && score.score <= assessment.maxMarks
          && teachesClass(assessment.classId) && teacherSubjectId() == assessment.subjectId
          && exists(enrollmentPath) && get(enrollmentPath).data.classId == assessment.classId;
      }

      // Student and parent access (feature 048). familyAccess/{uid} links a student or parent
      // account to one student and can be switched off by the owner. Family accounts read only
      // published results for that student. Each helper uses at most two access calls because a
      // request may make ten in total across every rule that is evaluated.
      function familyActive() {
        return get(/databases/$(database)/documents/schools/$(schoolId)/familyAccess/$(request.auth.uid)).data.active == true;
      }
      function familyOwns(studentId) {
        return familyActive()
          && (get(/databases/$(database)/documents/schools/$(schoolId)/familyAccess/$(request.auth.uid)).data.studentId == studentId
            || studentId in get(/databases/$(database)/documents/schools/$(schoolId)/familyAccess/$(request.auth.uid)).data.get('extraStudentIds', []));
      }

      // Notices. notices/{noticeId}: title, body, audience (all, teachers, families or class), classId
      // (only with the class audience), createdAt (YYYY-MM-DD), createdBy. The owner posts and removes
      // them; a notice is never edited. Teachers read notices for all or for teachers, and class notices
      // for a class they are class teacher of or teach. A linked student or parent reads notices for all
      // or for families, and class notices for the class their student is placed in this year.
      function familyInClass(classId) {
        let settings = /databases/$(database)/documents/schools/$(schoolId)/settings/academic;
        let link = /databases/$(database)/documents/schools/$(schoolId)/familyAccess/$(request.auth.uid);
        let enrollment = /databases/$(database)/documents/schools/$(schoolId)/enrollments/$(get(settings).data.activeYearId + '_' + get(link).data.studentId);
        return familyActive() && ((exists(settings) && exists(enrollment) && get(enrollment).data.classId == classId)
          || classId in get(link).data.get('extraClassIds', []));
      }

      match /notices/{noticeId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId)
          || (resource.data.audience in ['all', 'teachers'] && isActiveTeacher())
          || (resource.data.audience in ['all', 'families'] && familyActive())
          || (resource.data.audience == 'class' && (classTeacherOf(resource.data.classId)
            || teachesClass(resource.data.classId) || familyInClass(resource.data.classId))));
        allow create: if request.auth != null && (isSchoolOwner(schoolId) || isActivePrincipal(schoolId))
          && noticeId.matches('[A-Za-z0-9-]{1,30}')
          && validNotice(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt <= latestAttendanceDate()
          && (request.resource.data.audience != 'class'
            || classExists(schoolId, request.resource.data.classId));
        allow delete: if ownerAuth(schoolId);
      }

      // Audit trail. auditLog/{logId}: who (actor) did what (action) to which record (target, docId)
      // and when (at, an ISO time). The owner's changes are logged by the app; entries are written once
      // and never edited or deleted, and only the owner reads them. Teachers can add entries only for the
      // marks and attendance they save.
      match /auditLog/{logId} {
        allow get, list: if viewerAuth(schoolId);
        allow create: if request.auth != null
          && (isSchoolOwner(schoolId) || isActivePrincipal(schoolId)
            || (isActiveTeacher() && request.resource.data.action in ['marks', 'attendance']))
          && logId.matches('[A-Za-z0-9-]{1,40}')
          && validAuditEntry(request.resource.data)
          && request.resource.data.actor == request.auth.uid
          && request.resource.data.at[0:10] <= latestAttendanceDate();
        allow update, delete: if false;
      }

      // Timetable. timetable/{classId}_{day}_{period}: one lesson slot of a class's week. The owner
      // manages it; any active teacher reads it, and a linked family reads their own class's slots.
      match /timetable/{slotId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || isActiveTeacher()
          || familyInClass(resource.data.classId));
        allow create, update: if ownerAuth(schoolId)
          && validTimetableSlot(request.resource.data)
          && slotId == request.resource.data.classId + '_' + string(request.resource.data.day) + '_' + string(request.resource.data.period)
          && classExists(schoolId, request.resource.data.classId);
        allow delete: if ownerAuth(schoolId);
      }

      // Homework. homework/{homeworkId}: classId, subjectId, subject, title, details, dueDate, createdAt,
      // createdBy. The subject teacher of a class (or the owner) posts it and removes their own; it is
      // never edited. Read by the owner, the class's teachers, and families whose student is in the class.
      match /homework/{homeworkId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId)
          || teachesClass(resource.data.classId) || classTeacherOf(resource.data.classId)
          || familyInClass(resource.data.classId));
        allow create: if request.auth != null
          && homeworkId.matches('[A-Za-z0-9-]{1,30}')
          && validHomework(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt <= latestAttendanceDate()
          && request.resource.data.dueDate >= request.resource.data.createdAt
          && classExists(schoolId, request.resource.data.classId)
          && (isSchoolOwner(schoolId)
            || (teachesClass(request.resource.data.classId) && teacherSubjectId() == request.resource.data.subjectId));
        allow delete: if request.auth != null && (isSchoolOwner(schoolId)
          || (isActiveTeacher() && resource.data.createdBy == request.auth.uid));
      }

      // Study materials. materials/{materialId}: classId, subject, title, link (an https web address to notes
      // or a file the teacher keeps online), createdAt, createdBy. The owner, or the teacher of that class, posts
      // them; a material is never edited. The owner or the teacher who posted it removes it. The same people
      // who read homework read it: the owner, the class's teachers, and linked families of that class.
      match /materials/{materialId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId)
          || teachesClass(resource.data.classId) || classTeacherOf(resource.data.classId)
          || familyInClass(resource.data.classId));
        allow create: if request.auth != null
          && materialId.matches('[A-Za-z0-9-]{1,30}')
          && validMaterial(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt <= latestAttendanceDate()
          && classExists(schoolId, request.resource.data.classId)
          && (isSchoolOwner(schoolId) || teachesClass(request.resource.data.classId));
        allow delete: if request.auth != null && (isSchoolOwner(schoolId)
          || (isActiveTeacher() && resource.data.createdBy == request.auth.uid));
      }

      // School calendar. calendar/{eventId}: title, date, kind (holiday, exam, event or meeting), optional
      // note. The owner manages it; every active teacher and linked family reads it.
      match /calendar/{eventId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || isActiveTeacher() || familyActive());
        allow create, update: if ownerAuth(schoolId)
          && eventId.matches('[A-Za-z0-9-]{1,30}') && validCalendarEvent(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      // Library. books/{bookId}: title, author, copies. loans/{loanId}: bookId, studentId, issuedOn, dueOn,
      // issuedBy, and returnedOn once it comes back. Office records: only the owner reads or writes them.
      // A loan is never deleted; a return is the one allowed change, made once.
      match /books/{bookId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && bookId.matches('[a-z0-9-]{1,20}') && validBook(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      match /loans/{loanId} {
        allow get, list: if viewerAuth(schoolId);
        allow create: if ownerAuth(schoolId)
          && loanId.matches('[A-Za-z0-9-]{1,30}') && validLoan(request.resource.data)
          && !request.resource.data.keys().hasAny(['returnedOn'])
          && request.resource.data.issuedBy == request.auth.uid
          && request.resource.data.issuedOn <= latestAttendanceDate()
          && request.resource.data.dueOn >= request.resource.data.issuedOn
          && exists(/databases/$(database)/documents/schools/$(schoolId)/books/$(request.resource.data.bookId))
          && studentExists(schoolId, request.resource.data.studentId);
        allow update: if ownerAuth(schoolId)
          && validLoan(request.resource.data)
          && !resource.data.keys().hasAny(['returnedOn'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returnedOn'])
          && request.resource.data.returnedOn >= resource.data.issuedOn
          && request.resource.data.returnedOn <= latestAttendanceDate();
        // A renewal (feature 137): the due date moves later, at most 3 times, and only while the book is still out.
        allow update: if ownerAuth(schoolId)
          && validLoan(request.resource.data)
          && !resource.data.keys().hasAny(['returnedOn']) && !request.resource.data.keys().hasAny(['returnedOn'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dueOn', 'renewals'])
          && request.resource.data.dueOn > resource.data.dueOn
          && request.resource.data.renewals == resource.data.get('renewals', 0) + 1;
        allow delete: if false;
      }

      // Book reservations (feature 137). bookReservations/{id}: bookId, bookTitle, studentId, studentName, createdOn, status.
      match /bookReservations/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validReservation(request.resource.data)
          && exists(/databases/$(database)/documents/schools/$(schoolId)/books/$(request.resource.data.bookId))
          && studentExists(schoolId, request.resource.data.studentId);
        allow delete: if ownerAuth(schoolId);
      }

      // Behaviour notes. behaviour/{noteId}: studentId, date, kind (positive or concern), note,
      // recordedBy. Owner only; written once and removed by the owner.
      match /behaviour/{noteId} {
        allow get, list: if sensitiveAuth(schoolId);
        allow create: if ownerAuth(schoolId)
          && noteId.matches('[A-Za-z0-9-]{1,30}') && validBehaviour(request.resource.data)
          && request.resource.data.recordedBy == request.auth.uid
          && request.resource.data.date <= latestAttendanceDate()
          && studentExists(schoolId, request.resource.data.studentId);
        allow delete: if ownerAuth(schoolId);
      }

      // Visitor log. visitors/{visitId}: name, purpose, whom, phone, date, timeIn, recordedBy, and
      // timeOut once they leave. Owner only; never deleted.
      match /visitors/{visitId} {
        allow get, list: if sensitiveAuth(schoolId);
        allow create: if ownerAuth(schoolId)
          && visitId.matches('[A-Za-z0-9-]{1,30}') && validVisitor(request.resource.data)
          && !request.resource.data.keys().hasAny(['timeOut'])
          && request.resource.data.recordedBy == request.auth.uid
          && request.resource.data.date <= latestAttendanceDate();
        allow update: if ownerAuth(schoolId)
          && validVisitor(request.resource.data)
          && !resource.data.keys().hasAny(['timeOut'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timeOut'])
          && request.resource.data.timeOut >= resource.data.timeIn;
        allow delete: if false;
      }

      // Substitute cover. substitutions/{id}: date, classId, className, period, substituteUid, optional
      // absentTeacher and note, createdBy. The owner arranges and removes it; the substitute teacher
      // (and the owner) read it.
      match /substitutions/{subId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId)
          || (isActiveTeacher() && resource.data.substituteUid == request.auth.uid));
        allow create: if ownerAuth(schoolId)
          && subId.matches('[A-Za-z0-9-]{1,30}') && validSubstitution(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && activeTeacherMember(request.resource.data.substituteUid)
          && classExists(schoolId, request.resource.data.classId);
        allow delete: if ownerAuth(schoolId);
      }

      // Transport. routes/{routeId}: name, vehicle, driver, driverPhone, stops. transportRiders/{studentId}:
      // studentId, routeId, optional stop. The owner manages both; linked families read routes and their
      // own student's rider record.
      match /routes/{routeId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || isFeeStaff(schoolId) || familyActive());
        allow create, update: if ownerAuth(schoolId)
          && routeId.matches('[A-Za-z0-9-]{1,30}') && validRoute(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      match /transportRiders/{riderId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || isFeeStaff(schoolId) || familyOwns(resource.data.studentId));
        allow create, update: if ownerAuth(schoolId)
          && validRider(request.resource.data) && riderId == request.resource.data.studentId
          && exists(/databases/$(database)/documents/schools/$(schoolId)/routes/$(request.resource.data.routeId))
          && studentExists(schoolId, request.resource.data.studentId);
        allow delete: if ownerAuth(schoolId);
      }

      // Activities. activities/{activityId}: name, optional teacher and schedule.
      // activityMembers/{activityId}_{studentId}: activityId, studentId, joinedOn. The owner manages both;
      // teachers and linked families read activities, and families read their own student's memberships.
      match /activities/{activityId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || isActiveTeacher() || familyActive());
        allow create, update: if ownerAuth(schoolId)
          && activityId.matches('[A-Za-z0-9-]{1,30}') && validActivity(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      match /activityMembers/{memberId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || familyOwns(resource.data.studentId));
        allow create: if ownerAuth(schoolId)
          && validActivityMember(request.resource.data)
          && memberId == request.resource.data.activityId + '_' + request.resource.data.studentId
          && request.resource.data.joinedOn <= latestAttendanceDate()
          && exists(/databases/$(database)/documents/schools/$(schoolId)/activities/$(request.resource.data.activityId))
          && studentExists(schoolId, request.resource.data.studentId);
        allow delete: if ownerAuth(schoolId);
      }

      // Inventory. inventory/{itemId}: name, optional category and unit, quantity, minQuantity. Owner only.
      match /inventory/{itemId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && itemId.matches('[A-Za-z0-9-]{1,30}') && validInventoryItem(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      // Expenses. expenses/{id}: date, category, amount (whole rupees), optional note. Owner only.
      match /expenses/{expenseId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && expenseId.matches('[A-Za-z0-9-]{1,30}') && validExpense(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      // Certificates register. certificates/{certNo}: type, studentId, studentName, issuedOn, optional purpose.
      // Owner creates; an entry cannot be edited, only removed.
      match /certificates/{certNo} {
        allow get, list: if viewerAuth(schoolId);
        allow create: if ownerAuth(schoolId)
          && certNo.matches('[A-Za-z0-9-]{1,30}') && validCertificate(request.resource.data)
          && studentExists(schoolId, request.resource.data.studentId);
        allow delete: if ownerAuth(schoolId);
      }

      // Maintenance tickets. tickets/{id}: title, optional place, priority, status open/done.
      match /tickets/{ticketId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && ticketId.matches('[A-Za-z0-9-]{1,30}') && validTicket(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      // Staff directory. staffDirectory/{id}: name, role, optional phone, email, joinedOn. Owner only.
      match /staffDirectory/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validStaffCard(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      // Vehicles. vehicles/{VH-...}: registration, capacity and the insurance, fitness and driver-licence expiry
      // dates the Needs Attention list watches. Appraisals. appraisals/{AP-...}: staff name, date, rating 1-5, remarks.
      // The owner writes both; the principal reads them.
      match /vehicles/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('VH-[A-Za-z0-9-]{1,30}') && validVehicle(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }
      match /appraisals/{docId} {
        allow get, list: if sensitiveAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('AP-[A-Za-z0-9-]{1,30}') && validAppraisal(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      // Vendors. vendors/{id}: name, trade, optional phone, note. Owner only.
      match /vendors/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validVendor(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      // Meeting minutes. minutes/{id}: date, title, notes. Owner only.
      match /minutes/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validMinutes(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      // Lost and found. lostFound/{id}: item, kind lost/found, date, status open/returned, optional place. Owner only.
      match /lostFound/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validLostFound(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      // Fee concessions. concessions/{id}: studentId, studentName, kind, amount, givenOn, optional note. Owner only.
      match /concessions/{docId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || isFeeStaff(schoolId) || familyOwns(resource.data.studentId));
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validConcession(request.resource.data)
          && studentExists(schoolId, request.resource.data.studentId);
        allow delete: if ownerAuth(schoolId);
      }

      // Achievements. achievements/{id}: studentId, studentName, title, level, date. Owner only.
      match /achievements/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validAchievement(request.resource.data)
          && studentExists(schoolId, request.resource.data.studentId);
        allow delete: if ownerAuth(schoolId);
      }

      // Complaints. complaints/{id}: title, raisedBy, date, status open/resolved, optional note. Owner only.
      match /complaints/{docId} {
        allow get, list: if sensitiveAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validComplaint(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      // Scholarships (feature 152). scholarships/{SC-...}: a scheme. scholarshipApps/{SA-...}: one student's application, decided
      // once by the owner. Approving one also writes a fee concession in the same batch. Owner writes; the principal reads.
      match /scholarships/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('SC-[A-Za-z0-9-]{1,30}') && validScholarship(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      match /scholarshipApps/{docId} {
        allow get, list: if sensitiveAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('SA-[A-Za-z0-9-]{1,30}') && validScholarshipApp(request.resource.data)
          && studentExists(schoolId, request.resource.data.studentId)
          && exists(/databases/$(database)/documents/schools/$(schoolId)/scholarships/$(request.resource.data.schemeId));
        allow delete: if ownerAuth(schoolId);
      }

      // Parent consent forms (feature 151). consentForms/{CF-...}: a trip, photo or other permission the school asks for. The
      // owner writes them. consentResponses/{formId}_{studentId}: a linked parent says yes or no for their own child while the
      // form is open, and may change the answer. The owner and principal read every answer; a parent reads their own.
      match /consentForms/{docId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || familyActive());
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('CF-[A-Za-z0-9-]{1,30}') && validConsentForm(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      match /consentResponses/{docId} {
        allow get, list: if request.auth != null && (isSensitiveViewer(schoolId)
          || (resource.data.by == request.auth.uid && familyActive()));
        allow create: if request.auth != null && validConsentResponse(request.resource.data)
          && request.resource.data.by == request.auth.uid
          && familyOwns(request.resource.data.studentId)
          && docId == request.resource.data.formId + '_' + request.resource.data.studentId
          && get(/databases/$(database)/documents/schools/$(schoolId)/consentForms/$(request.resource.data.formId)).data.status == 'open';
        allow update: if request.auth != null && validConsentResponse(request.resource.data)
          && resource.data.by == request.auth.uid
          && request.resource.data.by == request.auth.uid
          && request.resource.data.formId == resource.data.formId && request.resource.data.studentId == resource.data.studentId
          && familyOwns(request.resource.data.studentId)
          && get(/databases/$(database)/documents/schools/$(schoolId)/consentForms/$(request.resource.data.formId)).data.status == 'open';
        allow delete: if false;
      }

      // Staff self-service (feature 143). staffProfiles/{teacherUid}: a teacher's own phone, address and emergency contact.
      match /staffProfiles/{uid} {
        allow get: if request.auth != null && (isSensitiveViewer(schoolId) || (isActiveTeacher() && request.auth.uid == uid));
        allow list: if sensitiveAuth(schoolId);
        allow create, update: if request.auth != null && isActiveTeacher() && request.auth.uid == uid
          && validStaffProfile(request.resource.data);
        allow delete: if false;
      }

      // Hostel (feature 144). hostelRooms/{id}: name, beds, optional block and monthlyFee. hostelStays/{id}: who sleeps where.
      match /hostelRooms/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validHostelRoom(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }
      match /hostelStays/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validHostelStay(request.resource.data)
          && exists(/databases/$(database)/documents/schools/$(schoolId)/hostelRooms/$(request.resource.data.roomId))
          && studentExists(schoolId, request.resource.data.studentId);
        allow delete: if ownerAuth(schoolId);
      }

      // Canteen (feature 145). canteenMenu/{id}: day, meal, items, optional price. canteenPlans/{id}: a student's meal plan.
      match /canteenMenu/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validCanteenMenu(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }
      match /canteenPlans/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validCanteenPlan(request.resource.data)
          && studentExists(schoolId, request.resource.data.studentId);
        allow delete: if ownerAuth(schoolId);
      }

      // Approval rules (feature 156). workflowRules/{id}: an expense at or above `over` rupees waits for approval.
      match /workflowRules/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validWorkflowRule(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      // Approval requests (feature 156). approvalRequests/{id}: a teacher or the principal asks the owner to approve a purchase, an expense, a
      // repair, an event or something else. The requester creates it as pending, reads their own, and may withdraw it while pending.
      // The owner and principal read all; only the owner decides, once, with an optional note.
      match /approvalRequests/{docId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || resource.data.requestedBy == request.auth.uid);
        allow create: if request.auth != null && (isActiveTeacher() || isActivePrincipal(schoolId))
          && docId.matches('AR-[A-Za-z0-9-]{1,27}') && validApprovalRequest(request.resource.data)
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedBy == request.auth.uid
          && !request.resource.data.keys().hasAny(['decidedBy', 'decidedOn', 'decisionNote']);
        allow update: if ownerAuth(schoolId) && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.decidedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedOn', 'decisionNote'])
          && validApprovalRequest(request.resource.data);
        allow delete: if ownerAuth(schoolId) || (request.auth != null && resource.data.requestedBy == request.auth.uid && resource.data.status == 'pending');
      }

      // Student pickup (feature 146). pickupPeople/{id}: a person allowed to collect a student, with a 6-digit code the
      // person shows at the gate. A family adds and changes its own student's people; the school sees them all.
      // pickupLogs/{id}: one record each time a child is handed over (owner or principal), written once with the server time.
      match /pickupPeople/{docId} {
        allow get: if request.auth != null && (isSensitiveViewer(schoolId) || (resource.data.createdBy == request.auth.uid && familyActive()));
        allow list: if request.auth != null && (isSensitiveViewer(schoolId) || (resource.data.createdBy == request.auth.uid && familyActive()));
        allow create: if request.auth != null && validPickupPerson(request.resource.data)
          && docId.matches('[A-Za-z0-9-]{1,30}')
          && request.resource.data.createdBy == request.auth.uid
          && (isSchoolOwner(schoolId) || familyOwns(request.resource.data.studentId))
          && studentExists(schoolId, request.resource.data.studentId);
        allow update: if request.auth != null && validPickupPerson(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.studentId == resource.data.studentId
          && (isSchoolOwner(schoolId) || (resource.data.createdBy == request.auth.uid && familyOwns(request.resource.data.studentId)));
        allow delete: if request.auth != null && (isSchoolOwner(schoolId)
          || (resource.data.createdBy == request.auth.uid && familyActive()));
      }
      match /pickupLogs/{docId} {
        allow get, list: if sensitiveAuth(schoolId);
        allow create: if request.auth != null && isStaffViewer(schoolId) && validPickupLog(request.resource.data)
          && docId.matches('[A-Za-z0-9-]{1,30}') && request.resource.data.by == request.auth.uid
          && studentExists(schoolId, request.resource.data.studentId);
        allow update, delete: if false;
      }

      // Question bank and online tests (feature 139). questionBank/{id}: one multiple-choice question.
      // onlineTests/{id}: the paper WITHOUT answers (a JSON text). onlineTestKeys/{id}: the answers, owner only, so a
      // student never receives them. onlineAttempts/{testId_studentId}: one answer sheet per student, made once while the
      // test is open; the owner then grades it (score and gradedOn are the only things that can change).
      match /questionBank/{docId} {
        allow get, list: if ownerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validQuestion(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }
      match /onlineTests/{docId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || (resource.data.status in ['open', 'closed'] && familyActive()));
        allow create: if ownerAuth(schoolId)
          && docId.matches('OT-[A-Za-z0-9-]{1,27}') && validOnlineTest(request.resource.data);
        allow update: if ownerAuth(schoolId) && validOnlineTest(request.resource.data)
          && (resource.data.status == 'draft'
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
        allow delete: if ownerAuth(schoolId);
      }
      match /onlineTestKeys/{docId} {
        allow get, list: if ownerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('OT-[A-Za-z0-9-]{1,27}') && validOnlineKey(request.resource.data)
          && existsAfter(/databases/$(database)/documents/schools/$(schoolId)/onlineTests/$(docId));
        allow delete: if ownerAuth(schoolId);
      }
      match /onlineAttempts/{docId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || (resource.data.by == request.auth.uid && familyActive()));
        allow create: if request.auth != null && validAttempt(request.resource.data)
          && request.resource.data.by == request.auth.uid
          && !request.resource.data.keys().hasAny(['score', 'gradedOn'])
          && request.resource.data.at == request.time
          && familyOwns(request.resource.data.studentId)
          && docId == request.resource.data.testId + '_' + request.resource.data.studentId
          && get(/databases/$(database)/documents/schools/$(schoolId)/onlineTests/$(request.resource.data.testId)).data.status == 'open';
        allow update: if ownerAuth(schoolId) && validAttempt(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'gradedOn'])
          && request.resource.data.keys().hasAll(['score', 'gradedOn']);
        allow delete: if false;
      }
      // Test progress. onlineProgress/{testId_studentId}: where a student is in an open test (answers, place, time left, pauses used).
      // The student's own family writes it while the test is open; the time left can only go down and a pause can only be added one at a time.
      match /onlineProgress/{docId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || (resource.data.by == request.auth.uid && familyActive()));
        allow create: if request.auth != null && validProgress(request.resource.data)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.pauses == 0 && request.resource.data.state == 'running'
          && familyOwns(request.resource.data.studentId)
          && docId == request.resource.data.testId + '_' + request.resource.data.studentId
          && get(/databases/$(database)/documents/schools/$(schoolId)/onlineTests/$(request.resource.data.testId)).data.status == 'open'
          && request.resource.data.remainingSec <= get(/databases/$(database)/documents/schools/$(schoolId)/onlineTests/$(request.resource.data.testId)).data.durationMin * 60;
        allow update: if request.auth != null && resource.data.by == request.auth.uid && validProgress(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'index', 'remainingSec', 'pauses', 'state', 'at'])
          && request.resource.data.at == request.time
          && request.resource.data.remainingSec <= resource.data.remainingSec
          && request.resource.data.pauses >= resource.data.pauses && request.resource.data.pauses <= resource.data.pauses + 1
          && ((request.resource.data.state == 'paused' && resource.data.state == 'running') == (request.resource.data.pauses == resource.data.pauses + 1))
          && familyActive()
          && get(/databases/$(database)/documents/schools/$(schoolId)/onlineTests/$(resource.data.testId)).data.status == 'open';
        allow delete: if false;
      }

      // Fee reminders (feature 148). feeReminders/{id}: a reminder the owner sent for a student with dues. The owner writes them;
      // the owner and principal read all; a linked family reads its own student's (query by studentId).
      match /feeReminders/{docId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || familyOwns(resource.data.studentId));
        allow create: if ownerAuth(schoolId)
          && docId.matches('FR-[A-Za-z0-9-]{1,27}') && validFeeReminder(request.resource.data)
          && request.resource.data.by == request.auth.uid
          && studentExists(schoolId, request.resource.data.studentId);
        allow update: if false;
        allow delete: if ownerAuth(schoolId);
      }

      // Phone notifications (feature 150). pushTokens/{uid}: the notification address of a family's phone, kept by that family only.
      // The server reads these (with admin rights) to send notices and fee reminders.
      match /pushTokens/{uid} {
        allow get: if request.auth != null && request.auth.uid == uid && familyActive();
        allow create, update: if request.auth != null && request.auth.uid == uid && validPushToken(request.resource.data)
          && familyOwns(request.resource.data.studentId);
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow list: if false;
      }

      // Automatic backup result (feature 086). settings/autoBackup is written only by the nightly server job.
      match /settings/autoBackup {
        allow get: if viewerAuth(schoolId);
        allow create, update, delete: if false;
      }

      // Automatic fee reminders (feature 148). settings/autoReminders: the owner switches the nightly reminders on and sets the smallest due
      // amount, how many days to wait before reminding the same student again, and an optional message. settings/autoRemindersLog is the
      // server's note of its last run. The owner and principal read both.
      match /settings/autoReminders {
        allow get: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && request.resource.data.keys().hasOnly(['on', 'min', 'everyDays', 'message'])
          && request.resource.data.keys().hasAll(['on', 'min', 'everyDays'])
          && request.resource.data.on is bool
          && intIn(request.resource.data.min, 1, 100000000)
          && intIn(request.resource.data.everyDays, 1, 60)
          && optText(request.resource.data, 'message', 200);
        allow delete: if false;
      }
      match /settings/autoRemindersLog {
        allow get: if viewerAuth(schoolId);
        allow create, update, delete: if false;
      }

      // Security alerts (feature 091). securityAlerts/{id}: written only by the server when the activity log shows something sensitive
      // (a voided payment, a removed student, a year closed, a restore, a burst of removals). The owner and principal read them; the
      // owner may mark one as seen or delete it, and cannot change anything else.
      match /securityAlerts/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create: if false;
        allow update: if ownerAuth(schoolId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
          && request.resource.data.seen is bool;
        allow delete: if ownerAuth(schoolId);
      }

      // Assets register. assets/{id}: name, place, cost, condition, boughtOn. Owner only.
      match /assets/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validAsset(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      // Sales ledger (uniforms, books). sales/{id}: studentId, studentName, item, quantity, amount, date. Owner only.
      match /sales/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validSale(request.resource.data)
          && studentExists(schoolId, request.resource.data.studentId);
        allow delete: if ownerAuth(schoolId);
      }

      // Syllabus tracker. syllabus/{id}: className, subjectName, chapter, status. Owner only.
      match /syllabus/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validSyllabus(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      // Staff training log. trainings/{id}: staffName, course, date, hours. Owner only.
      match /trainings/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validTraining(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      // Daily diary. diary/{id}: date, entry. Owner only.
      match /diary/{docId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && docId.matches('[A-Za-z0-9-]{1,30}') && validDiary(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      // Billing and plan (features 064, 070, 072, 089, 101, 103). billing/main is written by the platform
      // administrator; the signup batch may create the first trial record. School owners and principals read it.
      // Messages from the platform (Batch 77): one copy per school, so delivery and reading can be tracked. The owner may only mark one read.
      match /platformInbox/{messageId} {
        allow get, list: if request.auth != null && (isOwnerRole(schoolId) || isPlatformAdmin());
        allow create: if isPlatformAdmin() && messageId.matches('M-[A-Za-z0-9-]{4,40}') && validInboxMessage(request.resource.data)
          && request.resource.data.at == request.time;
        allow update: if request.auth != null && isOwnerRole(schoolId) && !('readAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) && request.resource.data.readAt == request.time;
        allow delete: if isPlatformAdmin();
      }

      match /billing/{docId} {
        allow get: if request.auth != null && docId == 'main' && (isSchoolViewer(schoolId) || isPlatformAdmin());
        allow create, update: if isPlatformAdmin() && docId == 'main' && validBilling(request.resource.data);
        allow create: if request.auth != null && docId == 'main'
          && !exists(/databases/$(database)/documents/schools/$(schoolId))
          && getAfter(/databases/$(database)/documents/schools/$(schoolId)).data.createdBy == request.auth.uid
          && request.resource.data.keys().hasOnly(['plan', 'status', 'trialEnds', 'studentLimit', 'staffLimit'])
          && request.resource.data.plan == 'trial' && request.resource.data.status == 'trial'
          && request.resource.data.trialEnds is timestamp && request.resource.data.trialEnds <= request.time + duration.value(31, 'd')
          && request.resource.data.studentLimit == 50 && request.resource.data.staffLimit == 10;
      }

      // Invoices (071, 089). invoices/{id}: period, amount, dueOn, status due/paid/overdue, optional paidOn and note.
      match /invoices/{invoiceId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || isPlatformAdmin());
        allow create, update: if isPlatformAdmin() && invoiceId.matches('[A-Za-z0-9-]{1,30}') && validInvoice(request.resource.data);
        allow delete: if isPlatformAdmin();

        // Payments, failed attempts and refunds against an invoice (Batch 77). Written once, never changed. Every entry carries the id of its
        // audit entry, which must be created in the same batch.
        match /payments/{paymentId} {
          allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || isPlatformAdmin());
          allow create: if isPlatformAdmin() && paymentId.matches('PAY-[A-Za-z0-9-]{4,40}') && validInvoicePayment(request.resource.data)
            && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time
            && existsAfter(/databases/$(database)/documents/platformAudit/$(request.resource.data.auditId));
          allow update, delete: if false;
        }
      }

      // Custom domain requests (067). domainRequests/{id}: domain, status, optional note, createdOn.
      match /domainRequests/{requestId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || isPlatformAdmin());
        allow create: if ownerAuth(schoolId) && requestId.matches('[A-Za-z0-9-]{1,30}')
          && validDomainRequest(request.resource.data) && request.resource.data.status == 'requested'
          && !request.resource.data.keys().hasAny(['dnsTarget', 'checkedOn', 'ssl']);
        allow update: if isPlatformAdmin() && validDomainRequest(request.resource.data)
          && request.resource.data.domain == resource.data.domain;
      }

      // Data requests (110). dataRequests/{id}: kind export/deletion, status, optional note, createdOn.
      match /dataRequests/{requestId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || isPlatformAdmin());
        allow create: if ownerAuth(schoolId) && requestId.matches('[A-Za-z0-9-]{1,30}')
          && validDataRequest(request.resource.data) && request.resource.data.status == 'requested';
        allow update: if isPlatformAdmin() && validDataRequest(request.resource.data)
          && request.resource.data.kind == resource.data.kind;
      }

      // Consent (094). consents/{uid}: policyVersion and acceptedAt (server time). Each member records their own.
      match /consents/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || isSchoolViewer(schoolId));
        allow list: if viewerAuth(schoolId);
        allow create, update: if request.auth != null && request.auth.uid == uid
          && exists(/databases/$(database)/documents/schools/$(schoolId)/members/$(uid))
          && request.resource.data.keys().hasOnly(['policyVersion', 'acceptedAt'])
          && request.resource.data.policyVersion is string && request.resource.data.policyVersion.matches('[A-Za-z0-9.-]{1,20}')
          && request.resource.data.acceptedAt == request.time;
      }

      // Usage snapshot (084, 085, 103). usage/main: counts the owner records; the platform administrator reads it.
      match /usage/{docId} {
        allow get: if request.auth != null && docId == 'main' && (isSchoolViewer(schoolId) || isPlatformAdmin());
        allow create, update: if request.auth != null && docId == 'main' && isSchoolOwner(schoolId) && validUsage(request.resource.data);
      }

      // Alumni. alumni/{id}: name, passoutYear, optional contact, occupation and note. Owner only.
      match /alumni/{alumniId} {
        allow get, list: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && alumniId.matches('[A-Za-z0-9-]{1,30}') && validAlumnus(request.resource.data);
        allow delete: if ownerAuth(schoolId);
      }

      // Health records. healthRecords/{studentId}: studentId, bloodGroup, allergies, conditions,
      // emergencyContact, notes. The owner writes them; the owner and the linked family read them.
      match /healthRecords/{recordId} {
        allow get, list: if request.auth != null && (isSensitiveViewer(schoolId) || familyOwns(resource.data.studentId));
        allow create, update: if ownerAuth(schoolId)
          && validHealthRecord(request.resource.data) && recordId == request.resource.data.studentId
          && studentExists(schoolId, request.resource.data.studentId);
        allow delete: if ownerAuth(schoolId);
      }

      // Lesson plans. lessonPlans/{id}: classId, subjectId, subject, date, topic, objectives, createdAt,
      // createdBy. The subject teacher of a class (or the owner) writes one and removes their own; plans
      // are never edited. Read by the owner and by the teacher who wrote it.
      match /lessonPlans/{planId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId)
          || (isActiveTeacher() && resource.data.createdBy == request.auth.uid));
        allow create: if request.auth != null
          && planId.matches('[A-Za-z0-9-]{1,30}') && validLessonPlan(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt <= latestAttendanceDate()
          && classExists(schoolId, request.resource.data.classId)
          && (isSchoolOwner(schoolId)
            || (teachesClass(request.resource.data.classId) && teacherSubjectId() == request.resource.data.subjectId));
        allow delete: if request.auth != null && (isSchoolOwner(schoolId)
          || (isActiveTeacher() && resource.data.createdBy == request.auth.uid));
      }

      // Parent-teacher meetings. ptmSlots/{id}: classId, date, time (HH:MM), optional teacher, place, note.
      // The owner schedules and removes them; teachers read all, and a linked family reads the meetings
      // of the class their student is placed in this year.
      match /ptmSlots/{slotId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || isActiveTeacher() || familyInClass(resource.data.classId));
        allow create, update: if ownerAuth(schoolId)
          && slotId.matches('[A-Za-z0-9-]{1,30}') && validPtmSlot(request.resource.data)
          && classExists(schoolId, request.resource.data.classId);
        allow delete: if ownerAuth(schoolId);
      }

      // Payroll. payroll/{staffUid}_{YYYY-MM}: staffUid, month, basic, allowances, deductions (whole
      // rupees), optional paidOn and note. Salary details are for the owner only: nobody else can read them.
      match /payroll/{payrollId} {
        allow get, list: if request.auth != null && (isOwnerRole(schoolId) || hasGrant(schoolId, 'sensitive') || principalAllows(schoolId, 'payroll', false)
          || (isActiveTeacher() && resource.data.staffUid == request.auth.uid));
        allow create, update: if ownerAuth(schoolId)
          && validPayroll(request.resource.data)
          && payrollId == request.resource.data.staffUid + '_' + request.resource.data.month
          && exists(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.resource.data.staffUid));
        allow delete: if ownerAuth(schoolId);
      }

      // Messages from families. messages/{id}: studentId, subject, body, createdAt, createdBy, and the
      // owner's reply and repliedAt. A linked family sends one for its own student and reads only its own
      // messages (query createdBy == uid). The owner reads all, adds a reply (nothing else changes) and removes.
      match /messages/{messageId} {
        allow get, list: if request.auth != null && (isSensitiveViewer(schoolId)
          || (resource.data.createdBy == request.auth.uid && familyActive()));
        allow create: if request.auth != null && messageId.matches('[A-Za-z0-9-]{1,30}')
          && validMessage(request.resource.data)
          && !request.resource.data.keys().hasAny(['reply', 'repliedAt', 'mod', 'modNote'])
          && request.resource.data.createdBy == request.auth.uid
          && familyOwns(request.resource.data.studentId);
        allow update: if ownerAuth(schoolId)
          && validMessage(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'repliedAt', 'mod', 'modNote'])
          && request.resource.data.diff(resource.data).affectedKeys().hasAny(['reply', 'repliedAt', 'mod', 'modNote'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reply', 'repliedAt'])
            || request.resource.data.keys().hasAll(['reply', 'repliedAt']));
        allow delete: if ownerAuth(schoolId);
      }

      // Public website. site/main holds the text of the public school page (school.html). Anyone can read
      // that one document, so it must hold only what the school is happy to publish; only the owner edits it.
      match /site/{docId} {
        allow get: if docId in ['main', 'extras'];
        allow create, update: if ownerAuth(schoolId)
          && ((docId == 'main' && validSite(request.resource.data))
            || (docId == 'extras' && validSiteExtras(request.resource.data) && templateAllowed(request.resource.data)));
        allow delete: if ownerAuth(schoolId);
      }

      // Admission enquiries. enquiries/{EQ-...}: sent from the public page by anyone, always starting as
      // status new. Only the owner reads them, moves them through the pipeline (status and note change
      // and nothing else) and removes them.
      match /enquiries/{enquiryId} {
        allow get, list: if request.auth != null && (isOwnerRole(schoolId) || hasAccess(schoolId) || principalAllows(schoolId, 'admissions', true));
        allow create: if enquiryId.matches('EQ-[A-Za-z0-9-]{1,30}') && validEnquiry(request.resource.data)
          && request.resource.data.status == 'new' && !request.resource.data.keys().hasAny(['note']);
        allow update: if ownerAuth(schoolId) && validEnquiry(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note']);
        allow delete: if ownerAuth(schoolId);
      }

      // Event registration. eventRegistrations/{eventId}_{studentId}: a linked family registers its own
      // student for a calendar event and may cancel it; the owner reads and removes any.
      match /eventRegistrations/{regId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || familyOwns(resource.data.studentId));
        allow create: if request.auth != null && validEventReg(request.resource.data)
          && regId == request.resource.data.eventId + '_' + request.resource.data.studentId
          && request.resource.data.createdBy == request.auth.uid
          && familyOwns(request.resource.data.studentId)
          && exists(/databases/$(database)/documents/schools/$(schoolId)/calendar/$(request.resource.data.eventId));
        allow delete: if request.auth != null && (isSchoolOwner(schoolId) || familyOwns(resource.data.studentId));
      }

      // Homework submissions. submissions/{homeworkId}_{studentId}: a linked student or parent submits a
      // written answer once for a homework of the student's own class. The class teacher or subject teacher
      // reads the class's submissions and adds feedback (feedback and feedbackAt are the only changes);
      // the family reads its own; the owner reads all and removes.
      match /submissions/{submissionId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId)
          || teachesClass(resource.data.classId) || classTeacherOf(resource.data.classId)
          || familyOwns(resource.data.studentId));
        allow create: if request.auth != null && validSubmission(request.resource.data)
          && submissionId == request.resource.data.homeworkId + '_' + request.resource.data.studentId
          && request.resource.data.createdBy == request.auth.uid
          && !request.resource.data.keys().hasAny(['feedback', 'feedbackAt'])
          && familyOwns(request.resource.data.studentId)
          && get(/databases/$(database)/documents/schools/$(schoolId)/homework/$(request.resource.data.homeworkId)).data.classId == request.resource.data.classId
          && studentInClass(request.resource.data.studentId, request.resource.data.classId);
        allow update: if request.auth != null && validSubmission(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback', 'feedbackAt'])
          && (isSchoolOwner(schoolId) || teachesClass(resource.data.classId) || classTeacherOf(resource.data.classId));
        allow delete: if ownerAuth(schoolId);
      }

      // Continuous assessment. assessments/{id}: classId, subjectId, subject, title, date, maxMarks,
      // createdBy. The subject teacher of the class (or the owner) creates one and removes their own.
      // assessmentScores/{assessmentId}_{studentId}: one score per student, copied details checked
      // against the assessment, written by the subject teacher, read by the teacher, the owner and
      // the student's own family.
      match /assessments/{assessmentId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || teachesClass(resource.data.classId));
        allow create: if request.auth != null && assessmentId.matches('[A-Za-z0-9-]{1,30}')
          && validAssessment(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && classExists(schoolId, request.resource.data.classId)
          && (isSchoolOwner(schoolId)
            || (teachesClass(request.resource.data.classId) && teacherSubjectId() == request.resource.data.subjectId));
        allow delete: if request.auth != null && (isSchoolOwner(schoolId)
          || (isActiveTeacher() && resource.data.createdBy == request.auth.uid));
      }

      match /assessmentScores/{scoreId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId)
          || teachesClass(resource.data.classId) || familyOwns(resource.data.studentId));
        allow create, update: if request.auth != null && validScore(request.resource.data)
          && scoreId == request.resource.data.assessmentId + '_' + request.resource.data.studentId
          && request.resource.data.createdBy == request.auth.uid
          && scoreAllowed(request.resource.data);
        allow delete: if request.auth != null && (isSchoolOwner(schoolId)
          || (isActiveTeacher() && resource.data.createdBy == request.auth.uid));
      }

      match /familyAccess/{uid} {
        function familyMember() {
          let path = /databases/$(database)/documents/schools/$(schoolId)/members/$(uid);
          return exists(path) && get(path).data.active == true && get(path).data.role in ['student', 'parent'];
        }
        allow get: if request.auth != null && (isSensitiveViewer(schoolId) || (request.auth.uid == uid && familyMember()));
        allow list: if sensitiveAuth(schoolId);
        allow create, update: if ownerAuth(schoolId) && familyMember()
          && validFamilyAccess(request.resource.data)
          && studentExists(schoolId, request.resource.data.studentId);
      }

      // A pure status change leaves the name and the maximum marks untouched.
      function examUnchangedFields(before, after) {
        return after.name == before.name && after.maxMarks == before.maxMarks && after.get('passMarks', -1) == before.get('passMarks', -1);
      }

      // Helpers for student placement (feature 028).
      function openYear(yearId) {
        let year = /databases/$(database)/documents/schools/$(schoolId)/academicYears/$(yearId);
        return exists(year) && get(year).data.status in ['draft', 'active'];
      }
      function activeStudent(studentId) {
        let student = /databases/$(database)/documents/schools/$(schoolId)/students/$(studentId);
        return exists(student) && get(student).data.status == 'active';
      }
      function enrollmentAfter(yearId, studentId) {
        return getAfter(/databases/$(database)/documents/schools/$(schoolId)/enrollments/$(yearId + '_' + studentId)).data;
      }
      function rollKeyMatches(enrollment) {
        let key = getAfter(/databases/$(database)/documents/schools/$(schoolId)/rollKeys/$(enrollment.yearId + '_' + enrollment.sectionId + '_' + string(enrollment.rollNo))).data;
        return key.studentId == enrollment.studentId && key.yearId == enrollment.yearId
          && key.sectionId == enrollment.sectionId && key.rollNo == enrollment.rollNo;
      }
      function sectionInClass(sectionId, classId) {
        let section = /databases/$(database)/documents/schools/$(schoolId)/sections/$(sectionId);
        return exists(section) && get(section).data.classId == classId
          && exists(/databases/$(database)/documents/schools/$(schoolId)/classes/$(classId));
      }

      // Academic setup (features 018, 019, 020). Owner only; IDs are lowercase slugs.
      // academicYears/{yearId}: label, startDate, endDate (YYYY-MM-DD strings), status
      //   draft -> active -> closed. settings/academic.activeYearId points at the one
      //   active year; it must be written in the same batch as the year's status change.
      match /settings/academic {
        allow get: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && request.resource.data.keys().hasOnly(['activeYearId'])
          && request.resource.data.activeYearId is string
          && request.resource.data.activeYearId.matches('[a-z0-9-]{1,20}')
          && getAfter(/databases/$(database)/documents/schools/$(schoolId)/academicYears/$(request.resource.data.activeYearId)).data.status == 'active'
          && (resource == null || resource.data.activeYearId == request.resource.data.activeYearId
            || getAfter(/databases/$(database)/documents/schools/$(schoolId)/academicYears/$(resource.data.activeYearId)).data.status == 'closed');
      }

      // Grading rules. settings/grading: the pass percentage and the lowest percentage for each grade
      // (A+ down to E; anything below E is F). The owner sets them; teachers and linked families read them.
      // School settings. settings/preferences: working days (1 = Monday to 7 = Sunday), school hours, the
      // attendance percentage below which a student is flagged, and an optional term list.
      match /settings/preferences {
        allow get: if request.auth != null && (isSchoolViewer(schoolId) || isActiveTeacher());
        allow create, update: if ownerAuth(schoolId) && validPreferences(request.resource.data);
      }

      // Principal switches. settings/principalAccess: payroll, fees and admissions, each true or false. The owner
      // sets them; the owner and the principal read them.
      match /settings/principalAccess {
        allow get: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && request.resource.data.keys().hasOnly(['payroll', 'fees', 'admissions'])
          && request.resource.data.keys().hasAll(['payroll', 'fees', 'admissions'])
          && request.resource.data.payroll is bool && request.resource.data.fees is bool && request.resource.data.admissions is bool;
      }

      // School location (feature 130). settings/location: the school's map position, the distance a teacher must be within
      // to check in (30 metres or more), the worst GPS accuracy accepted, and the school's time zone as minutes ahead of UTC.
      // Only the platform administrator sets it. The school's staff read it.
      match /settings/location {
        allow get: if request.auth != null && (isSchoolViewer(schoolId) || isActiveTeacher() || isPlatformAdmin());
        allow create, update: if request.auth != null && isPlatformAdmin() && validLocation(request.resource.data);
        allow delete: if false;
      }

      // Teacher check-in and check-out (features 128, 158). staffCheckins/{date}_{teacherUid}_{in|out}: one record for each
      // check-in and check-out of a day, created once and never edited by the teacher. The server stamps the time. A
      // verified record is accepted only when the reported position is inside the school's distance and the GPS accuracy is
      // good enough. A teacher whose GPS fails sends a record with status review; the owner approves or rejects it.
      match /staffCheckins/{docId} {
        allow get: if request.auth != null && (isSensitiveViewer(schoolId)
          || (isActiveTeacher() && docId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}_' + request.auth.uid + '_(in|out)')));
        allow list: if sensitiveAuth(schoolId);
        allow create: if request.auth != null && isActiveTeacher()
          && request.resource.data.staffUid == request.auth.uid
          && (validVerifiedCheckin(schoolId, request.resource.data, docId)
            || validReviewCheckin(schoolId, request.resource.data, docId));
        allow update: if ownerAuth(schoolId)
          && resource.data.status == 'review'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewNote'])
          && request.resource.data.reviewedBy == request.auth.uid
          && (!request.resource.data.keys().hasAny(['reviewNote'])
            || (maxText(request.resource.data.reviewNote, 200)));
        allow delete: if false;
      }

      // School QR code (features 129, 158). The owner's or principal's screen posts a new code about once a minute and keeps the one before it as prev.
      match /settings/qrCode {
        allow get: if viewerAuth(schoolId);
        allow create, update: if request.auth != null && isStaffViewer(schoolId) && !schoolSuspended(schoolId)
          && request.resource.data.keys().hasOnly(['code', 'prev', 'at']) && request.resource.data.keys().hasAll(['code', 'at'])
          && request.resource.data.code is string && request.resource.data.code.matches('^[A-HJ-NP-Z2-9]{8}$')
          && (!request.resource.data.keys().hasAny(['prev'])
            || (request.resource.data.prev is string && request.resource.data.prev.matches('^[A-HJ-NP-Z2-9]{8}$')))
          && request.resource.data.at == request.time;
        allow delete: if false;
      }

      // Shift (feature 132). settings/shift: start and end time, minutes of grace before a check-in counts as late, and minutes of break.
      match /settings/shift {
        allow get: if request.auth != null && (isSchoolViewer(schoolId) || isActiveTeacher());
        allow create, update: if ownerAuth(schoolId) && validShift(request.resource.data);
        allow delete: if false;
      }

      // Selfie (feature 128). staffSelfies/{date}_{teacherUid}_{in|out}: a small compressed photo taken live at check-in.
      // The teacher saves it before the check-in and may replace it until the check-in exists. The school's owner and principal read it.
      match /staffSelfies/{docId} {
        allow get: if sensitiveAuth(schoolId);
        allow create, update: if request.auth != null && isActiveTeacher()
          && request.resource.data.keys().hasOnly(['staffUid', 'date', 'kind', 'photo', 'at'])
          && request.resource.data.keys().hasAll(['staffUid', 'date', 'kind', 'photo', 'at'])
          && request.resource.data.staffUid == request.auth.uid
          && request.resource.data.kind in ['in', 'out']
          && request.resource.data.date == checkinDay(get(/databases/$(database)/documents/schools/$(schoolId)/settings/location).data)
          && docId == request.resource.data.date + '_' + request.auth.uid + '_' + request.resource.data.kind
          && maxText(request.resource.data.photo, 40000)
          && request.resource.data.photo.matches('^data:image/jpeg;base64,.*')
          && request.resource.data.at == request.time
          && !exists(/databases/$(database)/documents/schools/$(schoolId)/staffCheckins/$(docId));
        allow delete: if false;
      }

      // Attendance disputes and missed punches (feature 133). attendanceDisputes/{date}_{teacherUid}: a teacher says what time
      // they came or left on a day the check-in did not work. The owner approves or rejects it once.
      match /attendanceDisputes/{docId} {
        allow get: if request.auth != null && (isSensitiveViewer(schoolId)
          || (isActiveTeacher() && docId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}_' + request.auth.uid)));
        allow list: if request.auth != null && (isSensitiveViewer(schoolId)
          || (isActiveTeacher() && resource.data.staffUid == request.auth.uid));
        allow create: if request.auth != null && isActiveTeacher()
          && request.resource.data.staffUid == request.auth.uid
          && validDispute(schoolId, request.resource.data, docId);
        allow update: if ownerAuth(schoolId)
          && resource.data.status == 'open'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewNote'])
          && request.resource.data.reviewedBy == request.auth.uid
          && (!request.resource.data.keys().hasAny(['reviewNote'])
            || (maxText(request.resource.data.reviewNote, 200)));
        allow delete: if false;
      }

      // Backup log. settings/backupLog: the date of the last backup the owner downloaded and its kind.
      match /settings/backupLog {
        allow get: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && request.resource.data.keys().hasOnly(['lastAt', 'kind']) && request.resource.data.keys().hasAll(['lastAt', 'kind'])
          && dateText(request.resource.data.lastAt) && request.resource.data.kind in ['full', 'zip'];
      }

      // Launch checklist. settings/launch: eight manual "done" ticks (m1 to m8) kept by the owner.
      match /settings/launch {
        allow get: if viewerAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && request.resource.data.keys().hasOnly(['m1', 'm2', 'm3', 'm4', 'm5', 'm6', 'm7', 'm8'])
          && (!request.resource.data.keys().hasAny(['m1']) || request.resource.data.m1 is bool)
          && (!request.resource.data.keys().hasAny(['m2']) || request.resource.data.m2 is bool)
          && (!request.resource.data.keys().hasAny(['m3']) || request.resource.data.m3 is bool)
          && (!request.resource.data.keys().hasAny(['m4']) || request.resource.data.m4 is bool)
          && (!request.resource.data.keys().hasAny(['m5']) || request.resource.data.m5 is bool)
          && (!request.resource.data.keys().hasAny(['m6']) || request.resource.data.m6 is bool)
          && (!request.resource.data.keys().hasAny(['m7']) || request.resource.data.m7 is bool)
          && (!request.resource.data.keys().hasAny(['m8']) || request.resource.data.m8 is bool);
      }

      // Storage records. storageRecords/{ST-...}: a log of the files the school keeps (name, kind, size in KB).
      // The owner keeps the log; the platform administrator reads it to compare with the storage plan.
      match /storageRecords/{recordId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || isPlatformAdmin());
        allow create, update: if ownerAuth(schoolId)
          && recordId.matches('ST-[A-Za-z0-9-]{1,30}') && validStorageRecord(request.resource.data)
          && (resource != null || withinStorage(schoolId));
        allow delete: if ownerAuth(schoolId);
      }

      // E-library (feature 136). eBooks/{EB-...}: details of a PDF kept in Cloud Storage at schools/{schoolId}/ebooks/{id}.
      // The owner adds, edits title, author and subject, and removes. Owner, principal, teachers and families read.
      match /eBooks/{bookId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || isActiveTeacher() || familyActive());
        allow create: if ownerAuth(schoolId) && bookId.matches('EB-[A-Za-z0-9-]{1,30}')
          && validEBook(request.resource.data) && withinStorage(schoolId);
        allow update: if ownerAuth(schoolId) && validEBook(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'author', 'subject']);
        allow delete: if ownerAuth(schoolId);
      }

      // Notice acknowledgements (feature 150). noticeAcks/{noticeId}_{studentId}: a family taps "Got it" on a notice, once.
      match /noticeAcks/{ackId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || (familyActive() && resource.data.by == request.auth.uid));
        allow create: if request.auth != null && familyActive() && validNoticeAck(request.resource.data)
          && request.resource.data.by == request.auth.uid
          && ackId == request.resource.data.noticeId + '_' + request.resource.data.studentId
          && familyOwns(request.resource.data.studentId)
          && exists(/databases/$(database)/documents/schools/$(schoolId)/notices/$(request.resource.data.noticeId));
        allow update, delete: if false;
      }

      // Staff document vault (feature 141). staffDocuments/{SD-...}: details of a file kept in Cloud Storage at
      // schools/{schoolId}/staffDocs/{id}. The owner adds, edits the title, type, expiry and note, and removes; the
      // principal and the platform administrator read the details. New files are refused when the plan's storage is full.
      match /staffDocuments/{docId} {
        allow get, list: if request.auth != null && (isSensitiveViewer(schoolId) || isPlatformAdmin());
        allow create: if ownerAuth(schoolId) && docId.matches('SD-[A-Za-z0-9-]{1,30}')
          && validStaffDocument(request.resource.data) && withinStorage(schoolId);
        allow update: if ownerAuth(schoolId) && validStaffDocument(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kind', 'title', 'expiryOn', 'note']);
        allow delete: if ownerAuth(schoolId);
      }

      // Student photos. studentPhotos/{studentId}: one small JPEG (data URL, shrunk in the browser). The owner
      // keeps it; the owner, principal and the student's own linked family read it.
      match /studentPhotos/{studentId} {
        allow get: if request.auth != null && (isSensitiveViewer(schoolId) || familyOwns(studentId));
        allow list: if sensitiveAuth(schoolId);
        allow create, update: if ownerAuth(schoolId)
          && studentId.matches('[a-z0-9-]{1,20}') && validImage(request.resource.data, 'photo')
          && exists(/databases/$(database)/documents/schools/$(schoolId)/students/$(studentId));
        allow delete: if ownerAuth(schoolId);
      }

      // School logo for printed documents. settings/branding: logo (JPEG data URL). Staff and linked families read it.
      match /settings/branding {
        allow get: if request.auth != null && (isSchoolViewer(schoolId) || isActiveTeacher() || familyActive());
        allow create, update: if ownerAuth(schoolId) && validImage(request.resource.data, 'logo');
        allow delete: if ownerAuth(schoolId);
      }

      // Student profile history. studentHistory/{SH-...}: who changed what and when. Written when the owner
      // edits a student; never edited or removed.
      match /studentHistory/{historyId} {
        allow get, list: if viewerAuth(schoolId);
        allow create: if ownerAuth(schoolId)
          && historyId.matches('SH-[A-Za-z0-9-]{1,30}') && validStudentHistory(request.resource.data)
          && request.resource.data.by == request.auth.uid;
      }

      match /settings/grading {
        allow get: if request.auth != null && (isSchoolViewer(schoolId) || isActiveTeacher() || familyActive());
        allow create, update: if ownerAuth(schoolId) && validGrading(request.resource.data);
      }

      match /academicYears/{yearId} {
        // Teachers read years (label, dates, status only) so a class teacher can find the active year.
        allow get, list: if request.auth != null && ((isSchoolViewer(schoolId) || isFeeStaff(schoolId)) || isActiveTeacher());
        allow create: if ownerAuth(schoolId)
          && yearId.matches('[a-z0-9-]{1,20}')
          && validYear(request.resource.data) && request.resource.data.status == 'draft';
        allow update: if ownerAuth(schoolId)
          && validYear(request.resource.data)
          && request.resource.data.label == resource.data.label
          && ((resource.data.status == 'draft' && request.resource.data.status == 'draft')
            || (resource.data.status == 'draft' && request.resource.data.status == 'active'
              && getAfter(/databases/$(database)/documents/schools/$(schoolId)/settings/academic).data.activeYearId == yearId)
            || (resource.data.status == 'active' && request.resource.data.status == 'closed'
              && request.resource.data.startDate == resource.data.startDate
              && request.resource.data.endDate == resource.data.endDate));
      }

      // classes/{classId}: name, order. sections/{sectionId}: classId, name.
      match /classes/{classId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || isFeeStaff(schoolId));
        // A class teacher reads their own class by ID, to show its name on the attendance sheet.
        allow get: if request.auth != null && classTeacherOf(classId);
        allow create, update: if ownerAuth(schoolId)
          && classId.matches('[a-z0-9-]{1,20}') && validClass(request.resource.data);
      }

      match /sections/{sectionId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || teachesClass(resource.data.classId)
          || classTeacherOf(resource.data.classId));
        allow create: if ownerAuth(schoolId)
          && sectionId.matches('[a-z0-9-]{1,31}') && validSection(request.resource.data)
          && classExists(schoolId, request.resource.data.classId);
        allow update: if ownerAuth(schoolId)
          && validSection(request.resource.data)
          && request.resource.data.classId == resource.data.classId;
      }

      // subjects/{subjectId}: name, code. classSubjects/{classId}_{subjectId}: classId, subjectId.
      match /subjects/{subjectId} {
        allow get, list: if viewerAuth(schoolId);
        allow get: if request.auth != null && familyActive();
        allow create, update: if ownerAuth(schoolId)
          && subjectId.matches('[a-z0-9-]{1,30}') && validSubject(request.resource.data);
      }

      match /classSubjects/{mappingId} {
        allow get, list: if viewerAuth(schoolId);
        allow create: if ownerAuth(schoolId)
          && request.resource.data.keys().hasOnly(['classId', 'subjectId'])
          && idText(request.resource.data.classId)
          && request.resource.data.subjectId is string && request.resource.data.subjectId.matches('[a-z0-9-]{1,30}')
          && mappingId == request.resource.data.classId + '_' + request.resource.data.subjectId
          && classExists(schoolId, request.resource.data.classId)
          && exists(/databases/$(database)/documents/schools/$(schoolId)/subjects/$(request.resource.data.subjectId));
      }

      // Exam configuration (features 040, 041). Owner only. One exam per year, class,
      // subject and exam key; the ID is yearId_classId_subjectId_examKey so duplicates
      // are impossible. The subject must be taught in the class, and the year must be
      // open. open -> locked -> approved. A locked exam cannot be edited but the owner can
      // reopen it; the owner approves a locked exam, and can withdraw approval back to locked.
      // Status changes may not change anything else. Teachers can only mark open exams.
      // exams/{examId}: yearId, classId, subjectId, examKey, name, maxMarks (1-1000), status.
      match /exams/{examId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || teachesExam(resource.data));
        allow get, list: if request.auth != null && resource.data.published == true && familyActive();
        allow create: if ownerAuth(schoolId)
          && validExam(request.resource.data)
          && request.resource.data.status == 'open'
          && examId == request.resource.data.yearId + '_' + request.resource.data.classId
            + '_' + request.resource.data.subjectId + '_' + request.resource.data.examKey
          && openYear(request.resource.data.yearId)
          && exists(/databases/$(database)/documents/schools/$(schoolId)/classSubjects/$(request.resource.data.classId + '_' + request.resource.data.subjectId));
        allow update: if ownerAuth(schoolId)
          && validExam(request.resource.data)
          && request.resource.data.yearId == resource.data.yearId
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.subjectId == resource.data.subjectId
          && request.resource.data.examKey == resource.data.examKey
          && openYear(resource.data.yearId)
          && (examUnchangedFields(resource.data, request.resource.data)
            ? (resource.data.status == 'locked' && request.resource.data.status in ['open', 'approved']
                && !request.resource.data.keys().hasAny(['published']))
              || (resource.data.status == 'approved' && request.resource.data.status == 'approved')
              || (resource.data.status == 'approved' && request.resource.data.status == 'locked'
                && !resource.data.keys().hasAny(['published']))
              || (resource.data.status == 'open' && request.resource.data.status in ['open', 'locked'])
            : resource.data.status == 'open' && request.resource.data.status in ['open', 'locked']);
      }
      // A principal may only approve a locked exam (locked -> approved, nothing else changes).
      match /exams/{examId} {
        allow update: if request.auth != null && isSchoolPrincipal(schoolId)
          && validExam(request.resource.data)
          && resource.data.status == 'locked' && request.resource.data.status == 'approved'
          && examUnchangedFields(resource.data, request.resource.data)
          && request.resource.data.yearId == resource.data.yearId
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.subjectId == resource.data.subjectId
          && request.resource.data.examKey == resource.data.examKey
          && request.resource.data.approvedBy == request.auth.uid
          && !request.resource.data.keys().hasAny(['published'])
          && openYear(resource.data.yearId);
      }

      // Exam marks (features 042, 043). marks/{examId}_{studentId}. Written by the teacher
      // assigned to the exam's class and subject, only while the exam is open and the
      // student is placed in that class. The maximum comes from the exam, not the teacher.
      // Owners can read every mark; a teacher can read only the marks they entered.
      match /marks/{markId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId)
          || (isActiveTeacher() && resource.data.enteredBy == request.auth.uid));
        // A student or parent reads only their own student's mark, by ID, once the exam is published.
        allow get: if request.auth != null && familyOwns(resource.data.studentId)
          && get(/databases/$(database)/documents/schools/$(schoolId)/exams/$(resource.data.examId)).data.published == true;
        allow create: if request.auth != null && isActiveTeacher()
          && validResultMark(request.resource.data)
          && request.resource.data.enteredBy == request.auth.uid
          && markId == request.resource.data.examId + '_' + request.resource.data.studentId
          && markAllowed(request.resource.data);
        allow update: if request.auth != null && isActiveTeacher()
          && validResultMark(request.resource.data)
          && resource.data.enteredBy == request.auth.uid
          && request.resource.data.enteredBy == resource.data.enteredBy
          && request.resource.data.examId == resource.data.examId
          && request.resource.data.studentId == resource.data.studentId
          && markAllowed(request.resource.data);
      }

      // Students (features 025, 026, 027, 029). Owner only. The document ID is the
      // lowercase admission number, so admission numbers are unique by construction.
      // students/{studentId}: admissionNo, name, guardianName, guardianPhone, status.
      match /students/{studentId} {
        allow get, list: if request.auth != null && (isSchoolViewer(schoolId) || isFeeStaff(schoolId));
        allow get: if request.auth != null && familyOwns(studentId);
        // A class teacher reads, one by one, the students placed in their class in the active year.
        allow get: if request.auth != null && classTeacherOfStudent(studentId);
        allow create: if ownerAuth(schoolId)
          && studentId.matches('[a-z0-9-]{1,20}') && validStudentRecord(request.resource.data)
          && withinLimit(schoolId, 'students', 'studentLimit')
          && request.resource.data.admissionNo.lower() == studentId
          && request.resource.data.status == 'active';
        allow update: if ownerAuth(schoolId)
          && validStudentRecord(request.resource.data)
          && request.resource.data.admissionNo == resource.data.admissionNo;
      }

      // Placement (feature 028). enrollments/{yearId}_{studentId}: yearId, studentId, classId,
      // sectionId, rollNo. rollKeys/{yearId}_{sectionId}_{rollNo}: yearId, sectionId, rollNo,
      // studentId. The two are always written in one batch, so a roll number belongs to one
      // student per section per year. Closed years are frozen.
      match /enrollments/{enrollmentId} {
        allow get, list: if request.auth != null && ((isSchoolViewer(schoolId) || isFeeStaff(schoolId)) || teachesClass(resource.data.classId)
          || classTeacherOf(resource.data.classId) || familyOwns(resource.data.studentId));
        allow create: if ownerAuth(schoolId)
          && validEnrollment(request.resource.data)
          && enrollmentId == request.resource.data.yearId + '_' + request.resource.data.studentId
          && openYear(request.resource.data.yearId)
          && activeStudent(request.resource.data.studentId)
          && sectionInClass(request.resource.data.sectionId, request.resource.data.classId)
          && rollKeyMatches(request.resource.data);
        allow update: if ownerAuth(schoolId)
          && validEnrollment(request.resource.data)
          && request.resource.data.yearId == resource.data.yearId
          && request.resource.data.studentId == resource.data.studentId
          && openYear(resource.data.yearId)
          && activeStudent(resource.data.studentId)
          && sectionInClass(request.resource.data.sectionId, request.resource.data.classId)
          && rollKeyMatches(request.resource.data);
      }

      match /rollKeys/{rollKeyId} {
        allow get, list: if viewerAuth(schoolId);
        allow create: if ownerAuth(schoolId)
          && validRollKey(request.resource.data)
          && rollKeyId == request.resource.data.yearId + '_' + request.resource.data.sectionId
            + '_' + string(request.resource.data.rollNo)
          && openYear(request.resource.data.yearId)
          && enrollmentAfter(request.resource.data.yearId, request.resource.data.studentId).sectionId
            == request.resource.data.sectionId
          && enrollmentAfter(request.resource.data.yearId, request.resource.data.studentId).rollNo
            == request.resource.data.rollNo;
        // A roll key may be released only when its student has moved to another section or roll.
        allow delete: if ownerAuth(schoolId)
          && openYear(resource.data.yearId)
          && (enrollmentAfter(resource.data.yearId, resource.data.studentId).sectionId != resource.data.sectionId
            || enrollmentAfter(resource.data.yearId, resource.data.studentId).rollNo != resource.data.rollNo);
      }

      match /teacherAssignments/{uid}/marks/{markId} {
        function assignedTeacher() {
          let member = /databases/$(database)/documents/schools/$(schoolId)/members/$(uid);
          return request.auth.uid == uid && exists(member)
            && get(member).data.active == true && get(member).data.role == 'teacher';
        }
        function matchesAssignment(mark) {
          let assignment = /databases/$(database)/documents/schools/$(schoolId)/teacherAssignments/$(uid);
          return exists(assignment) && mark.className == get(assignment).data.className
            && mark.subject == get(assignment).data.subject;
        }
        allow get: if request.auth != null && assignedTeacher() && matchesAssignment(resource.data);
        allow create, update: if request.auth != null && assignedTeacher()
          && validMark(request.resource.data, markId) && matchesAssignment(request.resource.data)
          && (resource == null || matchesAssignment(resource.data));
      }
    }

    function validAssignment(assignment) {
      return assignment.keys().hasAll(['className', 'subject'])
        && assignment.keys().hasOnly(['className', 'subject', 'classId', 'subjectId'])
        && maxText(assignment.className, 80)
        && assignment.className.matches('.*[^[:space:]].*')
        && maxText(assignment.subject, 80)
        && assignment.subject.matches('.*[^[:space:]].*')
        && (assignment.keys().hasAll(['classId', 'subjectId'])
          ? (idText(assignment.classId)
            && assignment.subjectId is string && assignment.subjectId.matches('[a-z0-9-]{1,30}'))
          : !assignment.keys().hasAny(['classId', 'subjectId']));
    }

    function validMark(mark, markId) {
      return mark.keys().hasAll(['className', 'subject', 'exam', 'roll', 'score', 'maximum'])
        && mark.keys().hasOnly(['className', 'subject', 'exam', 'roll', 'score', 'maximum'])
        && idText(mark.exam)
        && mark.roll is string && mark.roll.matches('[a-z0-9-]{1,24}')
        && markId == mark.exam + '_' + mark.roll
        && mark.maximum is int && mark.maximum > 0 && mark.maximum <= 1000
        && intMin(mark.score, 0) && mark.score <= mark.maximum;
    }

    function validYear(year) {
      return year.keys().hasOnly(['label', 'startDate', 'endDate', 'status'])
        && year.keys().hasAll(['label', 'startDate', 'endDate', 'status'])
        && namedText(year.label, 20)
        && dateText(year.startDate)
        && dateText(year.endDate)
        && year.endDate > year.startDate
        && year.status in ['draft', 'active', 'closed'];
    }

    function validClass(item) {
      return item.keys().hasOnly(['name', 'order']) && item.keys().hasAll(['name', 'order'])
        && namedText(item.name, 40)
        && intIn(item.order, 1, 100);
    }

    function validSection(item) {
      return item.keys().hasOnly(['classId', 'name']) && item.keys().hasAll(['classId', 'name'])
        && idText(item.classId)
        && namedText(item.name, 10);
    }

    function validSubject(item) {
      return item.keys().hasOnly(['name', 'code']) && item.keys().hasAll(['name', 'code'])
        && namedText(item.name, 80)
        && maxText(item.code, 12);
    }

    function validResultMark(mark) {
      return mark.keys().hasOnly(['examId', 'yearId', 'classId', 'subjectId', 'studentId', 'score', 'maxMarks', 'enteredBy', 'draft'])
        && (!mark.keys().hasAny(['draft']) || mark.draft == true)
        && mark.keys().hasAll(['examId', 'yearId', 'classId', 'subjectId', 'studentId', 'score', 'maxMarks', 'enteredBy'])
        && maxText(mark.examId, 100)
        && idText(mark.yearId)
        && idText(mark.classId)
        && mark.subjectId is string && mark.subjectId.matches('[a-z0-9-]{1,30}')
        && idText(mark.studentId)
        && mark.enteredBy is string
        && intIn(mark.maxMarks, 1, 1000)
        && intMin(mark.score, 0) && mark.score <= mark.maxMarks;
    }

    // Scholarships (feature 152). A scheme says how much, how many seats and the lowest marks percent; an application
    // belongs to one scheme and one student and is decided once.
    function validScholarship(item) {
      return item.keys().hasOnly(['name', 'criteria', 'amount', 'seats', 'minPercent', 'active'])
        && item.keys().hasAll(['name', 'amount', 'seats', 'minPercent', 'active'])
        && namedText(item.name, 60)
        && optText(item, 'criteria', 300)
        && intIn(item.amount, 1, 10000000)
        && intIn(item.seats, 1, 10000)
        && intIn(item.minPercent, 0, 100)
        && item.active is bool;
    }

    function validScholarshipApp(item) {
      return item.keys().hasOnly(['schemeId', 'schemeName', 'studentId', 'studentName', 'percent', 'status', 'appliedOn', 'decidedOn', 'note'])
        && item.keys().hasAll(['schemeId', 'schemeName', 'studentId', 'studentName', 'percent', 'status', 'appliedOn'])
        && item.schemeId is string && item.schemeId.matches('SC-[A-Za-z0-9-]{1,30}')
        && maxText(item.schemeName, 60)
        && idText(item.studentId)
        && namedText(item.studentName, 80)
        && intIn(item.percent, 0, 100)
        && item.status in ['applied', 'approved', 'rejected']
        && dateText(item.appliedOn)
        && (!item.keys().hasAny(['decidedOn']) || dateText(item.decidedOn))
        && (item.status == 'applied' || item.keys().hasAny(['decidedOn']))
        && optText(item, 'note', 200);
    }

    // Parent consent forms (feature 151).
    function validConsentForm(item) {
      return item.keys().hasOnly(['title', 'text', 'kind', 'status', 'dueOn', 'createdOn'])
        && item.keys().hasAll(['title', 'text', 'kind', 'status', 'createdOn'])
        && namedText(item.title, 120)
        && namedText(item.text, 1000)
        && item.kind in ['trip', 'photo', 'other']
        && item.status in ['open', 'closed']
        && (!item.keys().hasAny(['dueOn']) || dateText(item.dueOn))
        && dateText(item.createdOn);
    }

    function validConsentResponse(item) {
      return item.keys().hasOnly(['formId', 'studentId', 'decision', 'by', 'at'])
        && item.keys().hasAll(['formId', 'studentId', 'decision', 'by', 'at'])
        && item.formId is string && item.formId.matches('CF-[A-Za-z0-9-]{1,30}')
        && idText(item.studentId)
        && item.decision in ['yes', 'no']
        && item.by is string
        && item.at == request.time;
    }

    // Staff self-service (feature 143): a teacher's own contact details.
    function validStaffProfile(item) {
      return item.keys().hasOnly(['phone', 'address', 'emergencyName', 'emergencyPhone', 'updatedOn'])
        && item.keys().hasAll(['updatedOn'])
        && dateText(item.updatedOn)
        && (!item.keys().hasAny(['phone']) || (item.phone is string && item.phone.matches('[0-9+() -]{0,20}')))
        && optText(item, 'address', 200)
        && optText(item, 'emergencyName', 80)
        && (!item.keys().hasAny(['emergencyPhone']) || (item.emergencyPhone is string && item.emergencyPhone.matches('[0-9+() -]{0,20}')));
    }

    function validReservation(item) {
      return item.keys().hasOnly(['bookId', 'bookTitle', 'studentId', 'studentName', 'createdOn', 'status'])
        && item.keys().hasAll(['bookId', 'bookTitle', 'studentId', 'studentName', 'createdOn', 'status'])
        && idText(item.bookId)
        && textLen(item.bookTitle, 1, 120)
        && idText(item.studentId)
        && textLen(item.studentName, 1, 80)
        && dateText(item.createdOn)
        && item.status in ['waiting', 'ready', 'collected', 'cancelled'];
    }

    function validHostelRoom(item) {
      return item.keys().hasOnly(['name', 'block', 'beds', 'monthlyFee'])
        && item.keys().hasAll(['name', 'beds'])
        && textLen(item.name, 1, 40)
        && intIn(item.beds, 1, 50)
        && optText(item, 'block', 40)
        && (!item.keys().hasAny(['monthlyFee']) || (intIn(item.monthlyFee, 0, 1000000)));
    }

    function validHostelStay(item) {
      return item.keys().hasOnly(['studentId', 'studentName', 'roomId', 'roomName', 'from', 'status', 'leftOn'])
        && item.keys().hasAll(['studentId', 'studentName', 'roomId', 'roomName', 'from', 'status'])
        && idText(item.studentId)
        && textLen(item.studentName, 1, 80)
        && item.roomId is string && item.roomId.matches('[A-Za-z0-9-]{1,30}')
        && textLen(item.roomName, 1, 40)
        && dateText(item.from)
        && item.status in ['staying', 'left']
        && (!item.keys().hasAny(['leftOn']) || dateText(item.leftOn));
    }

    function validCanteenMenu(item) {
      return item.keys().hasOnly(['day', 'meal', 'items', 'price'])
        && item.keys().hasAll(['day', 'meal', 'items'])
        && item.day in ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']
        && item.meal in ['Breakfast', 'Lunch', 'Snacks', 'Dinner']
        && textLen(item.items, 1, 300)
        && (!item.keys().hasAny(['price']) || (intIn(item.price, 0, 100000)));
    }

    function validCanteenPlan(item) {
      return item.keys().hasOnly(['studentId', 'studentName', 'plan', 'monthlyFee', 'from', 'active'])
        && item.keys().hasAll(['studentId', 'studentName', 'plan', 'monthlyFee', 'from', 'active'])
        && idText(item.studentId)
        && textLen(item.studentName, 1, 80)
        && textLen(item.plan, 1, 40)
        && intIn(item.monthlyFee, 0, 1000000)
        && dateText(item.from) && item.active is bool;
    }

    function validWorkflowRule(item) {
      return item.keys().hasOnly(['name', 'over', 'kind'])
        && item.keys().hasAll(['name', 'over', 'kind'])
        && textLen(item.name, 1, 80)
        && item.kind == 'expense'
        && intIn(item.over, 1, 100000000);
    }

    function validApprovalRequest(item) {
      return item.keys().hasOnly(['kind', 'title', 'amount', 'note', 'requestedBy', 'requestedByName', 'createdOn', 'status', 'decidedBy', 'decidedOn', 'decisionNote'])
        && item.keys().hasAll(['kind', 'title', 'requestedBy', 'requestedByName', 'createdOn', 'status'])
        && item.kind in ['purchase', 'expense', 'repair', 'event', 'other']
        && textLen(item.title, 1, 80)
        && (!item.keys().hasAny(['amount']) || intIn(item.amount, 0, 100000000))
        && optText(item, 'note', 300)
        && item.requestedBy is string
        && textLen(item.requestedByName, 1, 60)
        && dateText(item.createdOn)
        && item.status in ['pending', 'approved', 'rejected']
        && (!item.keys().hasAny(['decidedBy']) || item.decidedBy is string)
        && (!item.keys().hasAny(['decidedOn']) || dateText(item.decidedOn))
        && optText(item, 'decisionNote', 200);
    }

    function validPickupPerson(item) {
      return item.keys().hasOnly(['studentId', 'name', 'relation', 'phone', 'code', 'active', 'createdBy'])
        && item.keys().hasAll(['studentId', 'name', 'relation', 'code', 'active', 'createdBy'])
        && idText(item.studentId)
        && textLen(item.name, 1, 80)
        && textLen(item.relation, 1, 40)
        && item.code is string && item.code.matches('[0-9]{6}')
        && item.active is bool && item.createdBy is string
        && (!item.keys().hasAny(['phone']) || (item.phone is string && item.phone.matches('[0-9+() -]{0,20}')));
    }

    function validPickupLog(item) {
      return item.keys().hasOnly(['studentId', 'studentName', 'personName', 'relation', 'at', 'by'])
        && item.keys().hasAll(['studentId', 'studentName', 'personName', 'relation', 'at', 'by'])
        && idText(item.studentId)
        && textLen(item.studentName, 1, 80)
        && textLen(item.personName, 1, 80)
        && maxText(item.relation, 40)
        && item.at == request.time && item.by is string;
    }

    function validQuestion(item) {
      return item.keys().hasOnly(['classId', 'subjectName', 'text', 'options', 'correct', 'marks'])
        && item.keys().hasAll(['classId', 'text', 'options', 'correct', 'marks'])
        && item.classId is string && item.classId.matches('[A-Za-z0-9-]{1,30}')
        && textLen(item.text, 1, 300)
        && item.options is list && item.options.size() >= 2 && item.options.size() <= 4
        && item.options[0] is string && item.options[0].size() >= 1 && item.options[0].size() <= 120
        && item.options[1] is string && item.options[1].size() >= 1 && item.options[1].size() <= 120
        && (item.options.size() < 3 || (item.options[2] is string && item.options[2].size() >= 1 && item.options[2].size() <= 120))
        && (item.options.size() < 4 || (item.options[3] is string && item.options[3].size() >= 1 && item.options[3].size() <= 120))
        && intMin(item.correct, 0) && item.correct < item.options.size()
        && intIn(item.marks, 1, 20)
        && optText(item, 'subjectName', 60);
    }

    function validOnlineTest(item) {
      return item.keys().hasOnly(['title', 'classId', 'className', 'durationMin', 'status', 'paper', 'count', 'totalMarks', 'createdOn'])
        && item.keys().hasAll(['title', 'classId', 'className', 'durationMin', 'status', 'paper', 'count', 'totalMarks', 'createdOn'])
        && textLen(item.title, 1, 120)
        && item.classId is string && item.classId.matches('[A-Za-z0-9-]{1,30}')
        && textLen(item.className, 1, 40)
        && intIn(item.durationMin, 5, 180)
        && item.status in ['draft', 'open', 'closed']
        && textLen(item.paper, 2, 30000)
        && intIn(item.count, 1, 60)
        && intIn(item.totalMarks, 1, 1200)
        && dateText(item.createdOn);
    }

    function validOnlineKey(item) {
      return item.keys().hasOnly(['key', 'marks'])
        && item.keys().hasAll(['key', 'marks'])
        && item.key is string && item.key.matches('[0-3](,[0-3]){0,59}')
        && item.marks is string && item.marks.matches('[0-9]{1,2}(,[0-9]{1,2}){0,59}');
    }

    function validAttempt(item) {
      return item.keys().hasOnly(['testId', 'studentId', 'answers', 'by', 'at', 'score', 'gradedOn'])
        && item.keys().hasAll(['testId', 'studentId', 'answers', 'by', 'at'])
        && item.testId is string && item.testId.matches('OT-[A-Za-z0-9-]{1,27}')
        && idText(item.studentId)
        && item.answers is string && item.answers.matches('[0-3x](,[0-3x]){0,59}')
        && item.by is string && item.at is timestamp
        && (!item.keys().hasAny(['score']) || (intIn(item.score, 0, 1200)))
        && (!item.keys().hasAny(['gradedOn']) || dateText(item.gradedOn));
    }

    function validProgress(item) {
      return item.keys().hasOnly(['testId', 'studentId', 'by', 'answers', 'index', 'remainingSec', 'pauses', 'state', 'at'])
        && item.keys().hasAll(['testId', 'studentId', 'by', 'answers', 'index', 'remainingSec', 'pauses', 'state', 'at'])
        && item.testId is string && item.testId.matches('OT-[A-Za-z0-9-]{1,27}')
        && idText(item.studentId)
        && item.answers is string && item.answers.matches('[0-3x](,[0-3x]){0,59}')
        && item.by is string && item.at is timestamp
        && intIn(item.index, 0, 59) && intIn(item.remainingSec, 0, 10800) && intIn(item.pauses, 0, 7)
        && item.state in ['paused', 'running'];
    }

    function validEBook(item) {
      return item.keys().hasOnly(['title', 'author', 'subject', 'fileName', 'sizeKb', 'uploadedOn', 'by'])
        && item.keys().hasAll(['title', 'fileName', 'sizeKb', 'uploadedOn', 'by'])
        && namedText(item.title, 120)
        && optText(item, 'author', 80)
        && optText(item, 'subject', 60)
        && namedText(item.fileName, 120)
        && intIn(item.sizeKb, 1, 20480)
        && dateText(item.uploadedOn)
        && item.by is string;
    }

    function validNoticeAck(item) {
      return item.keys().hasOnly(['noticeId', 'studentId', 'studentName', 'by', 'on'])
        && item.keys().hasAll(['noticeId', 'studentId', 'studentName', 'by', 'on'])
        && textLen(item.noticeId, 1, 40) && textLen(item.studentId, 1, 40)
        && namedText(item.studentName, 120)
        && item.by is string
        && dateText(item.on);
    }

    function validStaffDocument(item) {
      return item.keys().hasOnly(['staffId', 'staffName', 'kind', 'title', 'expiryOn', 'note', 'fileName', 'contentType', 'sizeKb', 'uploadedOn', 'by'])
        && item.keys().hasAll(['staffId', 'staffName', 'kind', 'title', 'fileName', 'contentType', 'sizeKb', 'uploadedOn', 'by'])
        && textLen(item.staffId, 1, 40)
        && namedText(item.staffName, 120)
        && item.kind in ['id-proof', 'contract', 'certificate', 'qualification', 'police', 'medical', 'other']
        && namedText(item.title, 100)
        && (!item.keys().hasAny(['expiryOn']) || dateText(item.expiryOn))
        && optText(item, 'note', 200)
        && namedText(item.fileName, 120)
        && item.contentType in ['application/pdf', 'image/jpeg', 'image/png']
        && intIn(item.sizeKb, 1, 5120)
        && dateText(item.uploadedOn)
        && item.by is string;
    }

    function validFeeReminder(item) {
      return item.keys().hasOnly(['studentId', 'studentName', 'amount', 'createdOn', 'message', 'by'])
        && item.keys().hasAll(['studentId', 'studentName', 'amount', 'createdOn', 'by'])
        && idText(item.studentId)
        && textLen(item.studentName, 1, 80)
        && intIn(item.amount, 1, 100000000)
        && dateText(item.createdOn) && item.by is string
        && optText(item, 'message', 200);
    }

    function validPushToken(item) {
      return item.keys().hasOnly(['token', 'studentId', 'classId', 'updatedOn'])
        && item.keys().hasAll(['token', 'studentId', 'updatedOn'])
        && textLen(item.token, 20, 600)
        && idText(item.studentId)
        && dateText(item.updatedOn)
        && (!item.keys().hasAny(['classId']) || (item.classId is string && item.classId.matches('[A-Za-z0-9-]{1,30}')));
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // School location and teacher check-in helpers (features 130, 128, 158).
    function validLocation(item) {
      return item.keys().hasOnly(['lat', 'lng', 'radiusM', 'maxAccuracyM', 'tzMinutes', 'setBy', 'setOn', 'qrRequired', 'selfieRequired'])
        && item.keys().hasAll(['lat', 'lng', 'radiusM', 'maxAccuracyM', 'tzMinutes', 'setBy', 'setOn'])
        && (!item.keys().hasAny(['qrRequired']) || item.qrRequired is bool)
        && (!item.keys().hasAny(['selfieRequired']) || item.selfieRequired is bool)
        && item.lat is number && item.lat >= -66 && item.lat <= 66
        && item.lng is number && item.lng >= -180 && item.lng <= 180
        && item.radiusM is number && item.radiusM >= 30 && item.radiusM <= 500
        && item.maxAccuracyM is number && item.maxAccuracyM >= 10 && item.maxAccuracyM <= 100
        && intIn(item.tzMinutes, 0, 840)
        && item.setBy == request.auth.uid
        && item.setOn == request.time;
    }

    // Flat-earth distance: good to well under a metre over a few hundred metres. The cosine of the school's latitude is
    // worked out from a short series because the rules have no trigonometry.
    function withinSchoolRadius(loc, lat, lng) {
      let x = loc.lat * 0.017453292519943295;
      let x2 = x * x;
      let c = 1.0 - x2 / 2.0 + x2 * x2 / 24.0 - x2 * x2 * x2 / 720.0 + x2 * x2 * x2 * x2 / 40320.0;
      let dy = (lat - loc.lat) * 111320.0;
      let dx = (lng - loc.lng) * 111320.0 * c;
      return dx * dx + dy * dy <= loc.radiusM * loc.radiusM;
    }

    function checkinDay(loc) {
      let t = request.time + duration.value(loc.tzMinutes, 'm');
      return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
    }

    function validCheckinBase(schoolId, item, docId) {
      let loc = get(/databases/$(database)/documents/schools/$(schoolId)/settings/location).data;
      return item.kind in ['in', 'out']
        && item.at == request.time
        && item.date == checkinDay(loc)
        && docId == item.date + '_' + item.staffUid + '_' + item.kind
        && (item.kind == 'in'
          || exists(/databases/$(database)/documents/schools/$(schoolId)/staffCheckins/$(item.date + '_' + item.staffUid + '_in')));
    }

    function validVerifiedCheckin(schoolId, item, docId) {
      let loc = get(/databases/$(database)/documents/schools/$(schoolId)/settings/location).data;
      return item.keys().hasOnly(['staffUid', 'date', 'kind', 'at', 'lat', 'lng', 'accuracy', 'status', 'qr'])
        && item.keys().hasAll(['staffUid', 'date', 'kind', 'at', 'lat', 'lng', 'accuracy', 'status'])
        && item.status == 'verified'
        && item.lat is number && item.lng is number && item.accuracy is number
        && item.accuracy >= 0 && item.accuracy <= loc.maxAccuracyM
        && withinSchoolRadius(loc, item.lat, item.lng)
        && validCheckinBase(schoolId, item, docId)
        && qrOk(schoolId, item, loc)
        && selfieOk(schoolId, loc, docId);
    }

    // School-posted QR code (features 129, 158). settings/qrCode holds the current code and the server time it was posted.
    // Teachers cannot read it; the rules read it for them, so a code is only known by someone who saw the school's screen.
    // A code is accepted for 150 seconds after it was posted. The code before it is also accepted for 60 seconds after the
    // new one is posted, so a teacher who scanned just before the change is not refused. When the school requires the QR,
    // a check-in without a good code is refused.
    function qrOk(schoolId, item, loc) {
      return item.keys().hasAny(['qr'])
        ? validQrCode(schoolId, item.qr)
        : loc.get('qrRequired', false) != true;
    }

    function validQrCode(schoolId, code) {
      let posted = get(/databases/$(database)/documents/schools/$(schoolId)/settings/qrCode).data;
      return code is string && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && ((code == posted.code && request.time < posted.at + duration.value(150, 's'))
          || (code == posted.get('prev', '') && request.time < posted.at + duration.value(60, 's')));
    }

    // Selfie (feature 128). staffSelfies/{same id as the check-in} must exist first when the school requires selfies.
    function selfieOk(schoolId, loc, docId) {
      return loc.get('selfieRequired', false) != true
        || exists(/databases/$(database)/documents/schools/$(schoolId)/staffSelfies/$(docId));
    }

    function hhmm(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validShift(item) {
      return item.keys().hasOnly(['start', 'end', 'graceMin', 'breakMin'])
        && item.keys().hasAll(['start', 'end', 'graceMin', 'breakMin'])
        && hhmm(item.start) && hhmm(item.end) && item.end > item.start
        && intIn(item.graceMin, 0, 120)
        && intIn(item.breakMin, 0, 240);
    }

    function validDispute(schoolId, item, docId) {
      let loc = get(/databases/$(database)/documents/schools/$(schoolId)/settings/location).data;
      return item.keys().hasOnly(['staffUid', 'date', 'reason', 'inTime', 'outTime', 'status', 'createdAt'])
        && item.keys().hasAll(['staffUid', 'date', 'reason', 'status', 'createdAt'])
        && item.keys().hasAny(['inTime', 'outTime'])
        && dateText(item.date) && item.date <= checkinDay(loc)
        && docId == item.date + '_' + item.staffUid
        && textLen(item.reason, 3, 300)
        && (!item.keys().hasAny(['inTime']) || hhmm(item.inTime))
        && (!item.keys().hasAny(['outTime']) || hhmm(item.outTime))
        && item.status == 'open'
        && item.createdAt == request.time;
    }

    function validReviewCheckin(schoolId, item, docId) {
      return item.keys().hasOnly(['staffUid', 'date', 'kind', 'at', 'status', 'reason', 'note', 'lat', 'lng', 'accuracy'])
        && item.keys().hasAll(['staffUid', 'date', 'kind', 'at', 'status', 'reason'])
        && item.status == 'review'
        && item.reason in ['gps-weak', 'gps-denied', 'other']
        && optText(item, 'note', 200)
        && (!item.keys().hasAny(['lat']) || (item.lat is number && item.lat >= -90 && item.lat <= 90))
        && (!item.keys().hasAny(['lng']) || (item.lng is number && item.lng >= -180 && item.lng <= 180))
        && (!item.keys().hasAny(['accuracy']) || (item.accuracy is number && item.accuracy >= 0))
        && validCheckinBase(schoolId, item, docId);
    }

    // Tomorrow's date in UTC as YYYY-MM-DD. One day of slack covers time zones ahead of UTC.
    function latestAttendanceDate() {
      let t = request.time + duration.value(1, 'd');
      return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
    }

    function validClassTeacher(item) {
      return item.keys().hasOnly(['teacherUid']) && item.keys().hasAll(['teacherUid'])
        && textLen(item.teacherUid, 1, 128);
    }

    function validAttendance(item) {
      return item.keys().hasOnly(['yearId', 'classId', 'studentId', 'date', 'status', 'markedBy', 'reason'])
        && item.keys().hasAll(['yearId', 'classId', 'studentId', 'date', 'status', 'markedBy'])
        && optionalText(item, 'reason', 120)
        && idText(item.yearId)
        && idText(item.classId)
        && idText(item.studentId)
        && dateText(item.date)
        && item.status in ['present', 'absent', 'late', 'leave']
        && item.markedBy is string;
    }

    function validStaffAttendance(item) {
      return item.keys().hasOnly(['staffUid', 'date', 'status', 'markedBy'])
        && item.keys().hasAll(['staffUid', 'date', 'status', 'markedBy'])
        && textLen(item.staffUid, 1, 128)
        && dateText(item.date) && item.date >= '2020-01-01'
        && item.status in ['present', 'absent', 'late', 'leave']
        && item.markedBy is string;
    }

    function validLeaveRequest(item) {
      return item.keys().hasAll(['staffUid', 'fromDate', 'toDate', 'reason', 'status'])
        && item.keys().hasOnly(['staffUid', 'fromDate', 'toDate', 'reason', 'status', 'decidedBy'])
        && textLen(item.staffUid, 1, 128)
        && dateText(item.fromDate) && item.fromDate >= '2020-01-01'
        && dateText(item.toDate)
        && item.toDate >= item.fromDate
        && namedText(item.reason, 200)
        && item.status in ['pending', 'approved', 'rejected']
        && (!item.keys().hasAny(['decidedBy']) || item.decidedBy is string);
    }

    function validStudentLeave(item) {
      return item.keys().hasAll(['studentId', 'studentName', 'classId', 'fromDate', 'toDate', 'reason', 'status', 'requestedBy'])
        && item.keys().hasOnly(['studentId', 'studentName', 'classId', 'fromDate', 'toDate', 'reason', 'status', 'requestedBy', 'decidedBy', 'decisionNote'])
        && textLen(item.studentId, 1, 40)
        && textLen(item.studentName, 1, 100)
        && textLen(item.classId, 1, 40)
        && dateText(item.fromDate) && item.fromDate >= '2020-01-01'
        && dateText(item.toDate) && item.toDate >= item.fromDate
        && namedText(item.reason, 300)
        && item.status in ['pending', 'approved', 'rejected']
        && maxText(item.requestedBy, 128)
        && (!item.keys().hasAny(['decidedBy']) || item.decidedBy is string)
        && optText(item, 'decisionNote', 200);
    }

    function validFeeStructure(item) {
      return item.keys().hasOnly(['yearId', 'classId', 'head', 'name', 'amount', 'dueOn'])
        && item.keys().hasAll(['yearId', 'classId', 'head', 'name', 'amount'])
        && (!item.keys().hasAny(['dueOn']) || (item.dueOn is string && item.dueOn.matches('20[0-9]{2}-[0-9]{2}-[0-9]{2}')))
        && idText(item.yearId)
        && idText(item.classId)
        && idText(item.head)
        && namedText(item.name, 60)
        && intIn(item.amount, 0, 10000000);
    }

    function validPayment(item) {
      return item.keys().hasOnly(['studentId', 'yearId', 'amount', 'date', 'method', 'receiptNo', 'receivedBy', 'voided'])
        && item.keys().hasAll(['studentId', 'yearId', 'amount', 'date', 'method', 'receiptNo', 'receivedBy'])
        && idText(item.studentId)
        && idText(item.yearId)
        && intIn(item.amount, 1, 10000000)
        && dateText(item.date) && item.date >= '2020-01-01'
        && item.method in ['cash', 'upi', 'bank', 'cheque']
        && item.receiptNo is string && item.receiptNo.matches('[A-Za-z0-9-]{1,24}')
        && item.receivedBy is string
        && (!item.keys().hasAny(['voided']) || item.voided == true);
    }

    function validNotice(item) {
      return item.keys().hasOnly(['title', 'body', 'audience', 'classId', 'createdAt', 'createdBy'])
        && item.keys().hasAll(['title', 'body', 'audience', 'createdAt', 'createdBy'])
        && namedText(item.title, 100)
        && namedText(item.body, 2000)
        && item.audience in ['all', 'teachers', 'families', 'class']
        && (item.audience == 'class'
          ? (item.keys().hasAny(['classId']) && idText(item.classId))
          : !item.keys().hasAny(['classId']))
        && dateText(item.createdAt) && item.createdAt >= '2020-01-01'
        && item.createdBy is string;
    }

    function validAuditEntry(item) {
      return item.keys().hasOnly(['actor', 'action', 'target', 'docId', 'at', 'detail'])
        && item.keys().hasAll(['actor', 'action', 'target', 'docId', 'at'])
        && item.actor is string
        && item.action in ['save', 'remove', 'void', 'decide-leave', 'activate-year', 'close-year', 'bulk', 'marks', 'attendance']
        && textLen(item.target, 1, 40)
        && maxText(item.docId, 100)
        && item.at is string && item.at.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]{8,14}Z') && item.at >= '2020-01-01'
        && optText(item, 'detail', 200);
    }

    function validGrading(item) {
      return item.keys().hasOnly(['passPercent', 'minAPlus', 'minA', 'minB', 'minC', 'minD', 'minE'])
        && item.keys().hasAll(['passPercent', 'minAPlus', 'minA', 'minB', 'minC', 'minD', 'minE'])
        && intIn(item.passPercent, 1, 100)
        && item.minAPlus is int && item.minA is int && item.minB is int
        && item.minC is int && item.minD is int && item.minE is int
        && item.minAPlus <= 100 && item.minAPlus > item.minA && item.minA > item.minB
        && item.minB > item.minC && item.minC > item.minD && item.minD > item.minE && item.minE >= 1;
    }

    function validTimetableSlot(item) {
      return item.keys().hasOnly(['classId', 'className', 'day', 'period', 'subject', 'start', 'end', 'teacher'])
        && item.keys().hasAll(['classId', 'className', 'day', 'period', 'subject', 'start', 'end'])
        && idText(item.classId)
        && textLen(item.className, 1, 40)
        && intIn(item.day, 1, 7)
        && intIn(item.period, 1, 12)
        && textLen(item.subject, 1, 40)
        && item.start is string && item.start.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && item.end is string && item.end.matches('([01][0-9]|2[0-3]):[0-5][0-9]') && item.end > item.start
        && optText(item, 'teacher', 60);
    }

    function validHomework(item) {
      return item.keys().hasOnly(['classId', 'subjectId', 'subject', 'title', 'details', 'dueDate', 'createdAt', 'createdBy'])
        && item.keys().hasAll(['classId', 'subjectId', 'subject', 'title', 'details', 'dueDate', 'createdAt', 'createdBy'])
        && idText(item.classId)
        && item.subjectId is string && item.subjectId.matches('[a-z0-9-]{1,30}')
        && textLen(item.subject, 1, 40)
        && namedText(item.title, 100)
        && namedText(item.details, 2000)
        && dateText(item.dueDate)
        && dateText(item.createdAt) && item.createdAt >= '2020-01-01'
        && item.createdBy is string;
    }

    function validMaterial(item) {
      return item.keys().hasOnly(['classId', 'subject', 'title', 'link', 'createdAt', 'createdBy'])
        && item.keys().hasAll(['classId', 'subject', 'title', 'link', 'createdAt', 'createdBy'])
        && idText(item.classId)
        && textLen(item.subject, 1, 40)
        && namedText(item.title, 100)
        && item.link is string && item.link.matches('https://[^ ]{4,400}')
        && dateText(item.createdAt) && item.createdAt >= '2020-01-01'
        && item.createdBy is string;
    }

    function validCalendarEvent(item) {
      return item.keys().hasOnly(['title', 'date', 'kind', 'note'])
        && item.keys().hasAll(['title', 'date', 'kind'])
        && namedText(item.title, 100)
        && dateText(item.date) && item.date >= '2020-01-01'
        && item.kind in ['holiday', 'exam', 'event', 'meeting']
        && optText(item, 'note', 300);
    }

    function validBook(item) {
      return item.keys().hasOnly(['title', 'author', 'copies'])
        && item.keys().hasAll(['title', 'author', 'copies'])
        && namedText(item.title, 120)
        && maxText(item.author, 80)
        && intIn(item.copies, 1, 1000);
    }

    function validLoan(item) {
      return item.keys().hasOnly(['bookId', 'studentId', 'issuedOn', 'dueOn', 'returnedOn', 'issuedBy', 'renewals'])
        && item.keys().hasAll(['bookId', 'studentId', 'issuedOn', 'dueOn', 'issuedBy'])
        && (!item.keys().hasAny(['renewals']) || (intIn(item.renewals, 1, 3)))
        && idText(item.bookId)
        && idText(item.studentId)
        && dateText(item.issuedOn) && item.issuedOn >= '2020-01-01'
        && dateText(item.dueOn)
        && item.issuedBy is string
        && (!item.keys().hasAny(['returnedOn'])
          || (dateText(item.returnedOn)));
    }

    function validBehaviour(item) {
      return item.keys().hasOnly(['studentId', 'date', 'kind', 'note', 'recordedBy'])
        && item.keys().hasAll(['studentId', 'date', 'kind', 'note', 'recordedBy'])
        && idText(item.studentId)
        && dateText(item.date) && item.date >= '2020-01-01'
        && item.kind in ['positive', 'concern']
        && namedText(item.note, 500)
        && item.recordedBy is string;
    }

    function validVisitor(item) {
      return item.keys().hasOnly(['name', 'purpose', 'whom', 'phone', 'date', 'timeIn', 'timeOut', 'recordedBy'])
        && item.keys().hasAll(['name', 'purpose', 'date', 'timeIn', 'recordedBy'])
        && namedText(item.name, 80)
        && namedText(item.purpose, 120)
        && optText(item, 'whom', 80)
        && (!item.keys().hasAny(['phone']) || (item.phone is string && item.phone.matches('[0-9+() -]{0,20}')))
        && dateText(item.date) && item.date >= '2020-01-01'
        && item.timeIn is string && item.timeIn.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && (!item.keys().hasAny(['timeOut']) || (item.timeOut is string && item.timeOut.matches('([01][0-9]|2[0-3]):[0-5][0-9]')))
        && item.recordedBy is string;
    }

    function validSubstitution(item) {
      return item.keys().hasOnly(['date', 'classId', 'className', 'period', 'substituteUid', 'absentTeacher', 'note', 'createdBy'])
        && item.keys().hasAll(['date', 'classId', 'className', 'period', 'substituteUid', 'createdBy'])
        && dateText(item.date) && item.date >= '2020-01-01'
        && idText(item.classId)
        && textLen(item.className, 1, 40)
        && intIn(item.period, 1, 12)
        && item.substituteUid is string && item.createdBy is string
        && optText(item, 'absentTeacher', 60)
        && optText(item, 'note', 200);
    }

    function validRoute(item) {
      return item.keys().hasOnly(['name', 'vehicle', 'driver', 'driverPhone', 'stops', 'monthlyFee'])
        && (!item.keys().hasAny(['monthlyFee']) || (intIn(item.monthlyFee, 0, 100000)))
        && item.keys().hasAll(['name'])
        && namedText(item.name, 60)
        && optText(item, 'vehicle', 30)
        && optText(item, 'driver', 60)
        && (!item.keys().hasAny(['driverPhone']) || (item.driverPhone is string && item.driverPhone.matches('[0-9+() -]{0,20}')))
        && optText(item, 'stops', 300);
    }

    function validRider(item) {
      return item.keys().hasOnly(['studentId', 'routeId', 'stop', 'months'])
        && item.keys().hasAll(['studentId', 'routeId'])
        && (!item.keys().hasAny(['months']) || (intIn(item.months, 0, 12)))
        && idText(item.studentId)
        && item.routeId is string && item.routeId.matches('[A-Za-z0-9-]{1,30}')
        && optText(item, 'stop', 60);
    }

    function validActivity(item) {
      return item.keys().hasOnly(['name', 'teacher', 'schedule'])
        && item.keys().hasAll(['name'])
        && namedText(item.name, 60)
        && optText(item, 'teacher', 60)
        && optText(item, 'schedule', 100);
    }

    function validActivityMember(item) {
      return item.keys().hasOnly(['activityId', 'studentId', 'joinedOn'])
        && item.keys().hasAll(['activityId', 'studentId', 'joinedOn'])
        && item.activityId is string && item.activityId.matches('[A-Za-z0-9-]{1,30}')
        && idText(item.studentId)
        && dateText(item.joinedOn) && item.joinedOn >= '2020-01-01';
    }

    function validExpense(item) {
      return item.keys().hasOnly(['date', 'category', 'amount', 'note', 'status', 'payMode', 'vendor', 'decidedOn'])
        && item.keys().hasAll(['date', 'category', 'amount'])
        && (!item.keys().hasAny(['status']) || item.status in ['pending', 'approved', 'rejected'])
        && (!item.keys().hasAny(['payMode']) || item.payMode in ['cash', 'bank', 'upi', 'cheque'])
        && optText(item, 'vendor', 80)
        && (!item.keys().hasAny(['decidedOn']) || dateText(item.decidedOn))
        && dateText(item.date)
        && namedText(item.category, 40)
        && intIn(item.amount, 1, 100000000)
        && optText(item, 'note', 200);
    }

    function validCertificate(item) {
      return item.keys().hasOnly(['type', 'studentId', 'studentName', 'issuedOn', 'purpose'])
        && item.keys().hasAll(['type', 'studentId', 'studentName', 'issuedOn'])
        && item.type in ['Bonafide', 'Transfer', 'Character']
        && idText(item.studentId)
        && namedText(item.studentName, 80)
        && dateText(item.issuedOn)
        && optText(item, 'purpose', 200);
    }

    function validTicket(item) {
      return item.keys().hasOnly(['title', 'place', 'priority', 'status', 'createdOn'])
        && item.keys().hasAll(['title', 'priority', 'status', 'createdOn'])
        && namedText(item.title, 120)
        && optText(item, 'place', 60)
        && item.priority in ['low', 'normal', 'high'] && item.status in ['open', 'done']
        && dateText(item.createdOn);
    }

    function validStaffCard(item) {
      return item.keys().hasOnly(['name', 'role', 'phone', 'email', 'joinedOn', 'qualification', 'emergencyPhone', 'address', 'experienceYears',
          'employeeId', 'department', 'employmentType', 'subjects', 'dateOfBirth', 'gender', 'bloodGroup', 'leftOn'])
        && item.keys().hasAll(['name', 'role'])
        && namedText(item.name, 80)
        && namedText(item.role, 40)
        && (!item.keys().hasAny(['phone']) || (item.phone is string && item.phone.matches('[0-9+() -]{1,20}')))
        && optText(item, 'email', 80)
        && (!item.keys().hasAny(['joinedOn']) || (dateText(item.joinedOn)))
        && optText(item, 'qualification', 100)
        && (!item.keys().hasAny(['emergencyPhone']) || (item.emergencyPhone is string && item.emergencyPhone.matches('[0-9+() -]{1,20}')))
        && optText(item, 'address', 200)
        && (!item.keys().hasAny(['experienceYears']) || (intIn(item.experienceYears, 0, 60)))
        && optText(item, 'employeeId', 20)
        && optText(item, 'department', 40)
        && (!item.keys().hasAny(['employmentType']) || item.employmentType in ['permanent', 'contract', 'part-time', 'visiting'])
        && optText(item, 'subjects', 100)
        && (!item.keys().hasAny(['dateOfBirth']) || (dateText(item.dateOfBirth)))
        && (!item.keys().hasAny(['gender']) || item.gender in ['male', 'female', 'other'])
        && (!item.keys().hasAny(['bloodGroup']) || item.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'])
        && (!item.keys().hasAny(['leftOn']) || (dateText(item.leftOn)));
    }

    function validVehicle(item) {
      return item.keys().hasOnly(['regNo', 'model', 'capacity', 'insuranceExpiry', 'fitnessExpiry', 'licenseExpiry', 'routeId'])
        && item.keys().hasAll(['regNo', 'capacity'])
        && namedText(item.regNo, 20)
        && optText(item, 'model', 60)
        && intIn(item.capacity, 1, 200)
        && (!item.keys().hasAny(['insuranceExpiry']) || (dateText(item.insuranceExpiry)))
        && (!item.keys().hasAny(['fitnessExpiry']) || (dateText(item.fitnessExpiry)))
        && (!item.keys().hasAny(['licenseExpiry']) || (dateText(item.licenseExpiry)))
        && optText(item, 'routeId', 40);
    }

    function validAppraisal(item) {
      return item.keys().hasOnly(['staffName', 'date', 'rating', 'remarks', 'cycle', 'goals', 'status'])
        && item.keys().hasAll(['staffName', 'date', 'rating'])
        && optText(item, 'cycle', 40)
        && optText(item, 'goals', 300)
        && (!item.keys().hasAny(['status']) || item.status in ['draft', 'submitted', 'approved'])
        && namedText(item.staffName, 80)
        && dateText(item.date) && item.date >= '2020-01-01'
        && intIn(item.rating, 1, 5)
        && optText(item, 'remarks', 300);
    }

    function validVendor(item) {
      return item.keys().hasOnly(['name', 'trade', 'phone', 'note'])
        && item.keys().hasAll(['name', 'trade'])
        && namedText(item.name, 80)
        && namedText(item.trade, 60)
        && (!item.keys().hasAny(['phone']) || (item.phone is string && item.phone.matches('[0-9+() -]{1,20}')))
        && optText(item, 'note', 200);
    }

    function validMinutes(item) {
      return item.keys().hasOnly(['date', 'title', 'notes'])
        && item.keys().hasAll(['date', 'title', 'notes'])
        && dateText(item.date)
        && namedText(item.title, 100)
        && namedText(item.notes, 3000);
    }

    function validLostFound(item) {
      return item.keys().hasOnly(['item', 'kind', 'date', 'status', 'place'])
        && item.keys().hasAll(['item', 'kind', 'date', 'status'])
        && namedText(item.item, 100)
        && item.kind in ['lost', 'found'] && item.status in ['open', 'returned']
        && dateText(item.date)
        && optText(item, 'place', 60);
    }

    function validConcession(item) {
      return item.keys().hasOnly(['studentId', 'studentName', 'kind', 'amount', 'givenOn', 'note'])
        && item.keys().hasAll(['studentId', 'studentName', 'kind', 'amount', 'givenOn'])
        && idText(item.studentId)
        && namedText(item.studentName, 80)
        && item.kind in ['Scholarship', 'Sibling discount', 'Staff ward', 'Other']
        && intIn(item.amount, 1, 10000000)
        && dateText(item.givenOn)
        && optText(item, 'note', 200);
    }

    function validAchievement(item) {
      return item.keys().hasOnly(['studentId', 'studentName', 'title', 'level', 'date'])
        && item.keys().hasAll(['studentId', 'studentName', 'title', 'level', 'date'])
        && idText(item.studentId)
        && namedText(item.studentName, 80)
        && namedText(item.title, 120)
        && item.level in ['School', 'District', 'State', 'National']
        && dateText(item.date);
    }

    function validComplaint(item) {
      return item.keys().hasOnly(['title', 'raisedBy', 'date', 'status', 'note', 'assignedTo', 'priority', 'dueOn', 'response', 'respondedOn'])
        && item.keys().hasAll(['title', 'raisedBy', 'date', 'status'])
        && namedText(item.title, 120)
        && namedText(item.raisedBy, 80)
        && item.status in ['open', 'in-progress', 'escalated', 'resolved']
        && dateText(item.date)
        && optText(item, 'note', 500)
        && optText(item, 'assignedTo', 80)
        && (!item.keys().hasAny(['priority']) || item.priority in ['low', 'normal', 'high'])
        && (!item.keys().hasAny(['dueOn']) || dateText(item.dueOn))
        && optText(item, 'response', 500)
        && (!item.keys().hasAny(['respondedOn']) || dateText(item.respondedOn));
    }

    function validAsset(item) {
      return item.keys().hasOnly(['name', 'place', 'cost', 'condition', 'boughtOn'])
        && item.keys().hasAll(['name', 'place', 'cost', 'condition'])
        && namedText(item.name, 100)
        && namedText(item.place, 60)
        && intIn(item.cost, 0, 1000000000)
        && item.condition in ['Good', 'Fair', 'Poor']
        && (!item.keys().hasAny(['boughtOn']) || (dateText(item.boughtOn)));
    }

    function validSale(item) {
      return item.keys().hasOnly(['studentId', 'studentName', 'item', 'quantity', 'amount', 'date'])
        && item.keys().hasAll(['studentId', 'studentName', 'item', 'quantity', 'amount', 'date'])
        && idText(item.studentId)
        && namedText(item.studentName, 80)
        && namedText(item.item, 80)
        && intIn(item.quantity, 1, 1000)
        && intIn(item.amount, 0, 10000000)
        && dateText(item.date);
    }

    function validSyllabus(item) {
      return item.keys().hasOnly(['className', 'subjectName', 'chapter', 'status'])
        && item.keys().hasAll(['className', 'subjectName', 'chapter', 'status'])
        && namedText(item.className, 40)
        && namedText(item.subjectName, 60)
        && namedText(item.chapter, 120)
        && item.status in ['Pending', 'In progress', 'Done'];
    }

    function validTraining(item) {
      return item.keys().hasOnly(['staffName', 'course', 'date', 'hours', 'status'])
        && item.keys().hasAll(['staffName', 'course', 'date', 'hours'])
        && (!item.keys().hasAny(['status']) || item.status in ['planned', 'completed'])
        && namedText(item.staffName, 80)
        && namedText(item.course, 120)
        && dateText(item.date)
        && intIn(item.hours, 1, 1000);
    }

    function validDiary(item) {
      return item.keys().hasOnly(['date', 'entry'])
        && item.keys().hasAll(['date', 'entry'])
        && dateText(item.date)
        && namedText(item.entry, 3000);
    }

    function dateText(value) {
      return value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    // Shared checks. Each one replaces text that was repeated many times, so the compiled rules stay under the size limit.
    function maxText(v, n) { return v is string && v.size() <= n; }
    function textLen(v, a, b) { return v is string && v.size() >= a && v.size() <= b; }
    function namedText(v, n) { return v is string && v.size() <= n && v.matches('.*[^[:space:]].*'); }
    function optText(item, key, n) { return !item.keys().hasAny([key]) || (item[key] is string && item[key].size() <= n); }
    function idText(v) { return v is string && v.matches('[a-z0-9-]{1,20}'); }
    function intIn(v, a, b) { return v is int && v >= a && v <= b; }
    function intMin(v, a) { return v is int && v >= a; }
    function ownerAuth(schoolId) { return request.auth != null && isSchoolOwner(schoolId); }
    function viewerAuth(schoolId) { return request.auth != null && isSchoolViewer(schoolId); }
    function sensitiveAuth(schoolId) { return request.auth != null && isSensitiveViewer(schoolId); }
    function studentExists(schoolId, id) { return exists(/databases/$(database)/documents/schools/$(schoolId)/students/$(id)); }
    function classExists(schoolId, id) { return exists(/databases/$(database)/documents/schools/$(schoolId)/classes/$(id)); }

    function validNewSchool(item) {
      return item.keys().hasOnly(['name', 'contactEmail', 'phone', 'address', 'createdBy'])
        && item.keys().hasAll(['name', 'contactEmail', 'phone', 'address', 'createdBy'])
        && item.createdBy is string
        && validProfile(item);
    }

    function validBilling(item) {
      return item.keys().hasOnly(['plan', 'status', 'trialEnds', 'graceDays', 'studentLimit', 'staffLimit', 'storageMb',
          'monthlyPrice', 'renewsOn', 'legalHold', 'autoBilling', 'note', 'startedOn'])
        && item.keys().hasAll(['plan', 'status'])
        && item.plan is string && item.plan.matches('[a-z][a-z0-9-]{1,29}')
        && item.status in ['trial', 'active', 'suspended', 'cancelled', 'pending']
        && (!item.keys().hasAny(['trialEnds']) || item.trialEnds is timestamp)
        && (!item.keys().hasAny(['graceDays']) || (intIn(item.graceDays, 0, 90)))
        && (!item.keys().hasAny(['studentLimit']) || (intIn(item.studentLimit, 0, 1000000)))
        && (!item.keys().hasAny(['staffLimit']) || (intIn(item.staffLimit, 0, 1000000)))
        && (!item.keys().hasAny(['storageMb']) || (intIn(item.storageMb, 0, 10000000)))
        && (!item.keys().hasAny(['monthlyPrice']) || (intIn(item.monthlyPrice, 0, 10000000)))
        && (!item.keys().hasAny(['renewsOn']) || dateText(item.renewsOn))
        && (!item.keys().hasAny(['legalHold']) || item.legalHold is bool)
        && (!item.keys().hasAny(['autoBilling']) || item.autoBilling is bool)
        && (!item.keys().hasAny(['startedOn']) || dateText(item.startedOn))
        && optText(item, 'note', 200);
    }

    function validInvoice(item) {
      return item.keys().hasOnly(['period', 'amount', 'dueOn', 'status', 'paidOn', 'note', 'kind', 'amountPaid', 'refunded'])
        && item.keys().hasAll(['period', 'amount', 'dueOn', 'status'])
        && (!item.keys().hasAny(['kind']) || item.kind in ['subscription', 'setup'])
        && (!item.keys().hasAny(['amountPaid']) || (intIn(item.amountPaid, 0, 100000000) && item.amountPaid <= item.amount))
        && (!item.keys().hasAny(['refunded']) || (intIn(item.refunded, 0, 100000000) && item.refunded <= item.get('amountPaid', 0)))
        && item.period is string && item.period.matches('[0-9]{4}-[0-9]{2}')
        && intIn(item.amount, 0, 100000000)
        && dateText(item.dueOn)
        && item.status in ['due', 'paid', 'overdue']
        && (!item.keys().hasAny(['paidOn']) || dateText(item.paidOn))
        && optText(item, 'note', 200);
    }

    function validDomainMap(item) {
      return item.keys().hasOnly(['schoolId', 'verifiedOn'])
        && item.keys().hasAll(['schoolId', 'verifiedOn'])
        && item.schoolId is string && item.schoolId.matches('[a-z][a-z0-9-]{2,29}')
        && dateText(item.verifiedOn);
    }

    function validDomainRequest(item) {
      return item.keys().hasOnly(['domain', 'status', 'note', 'createdOn', 'dnsTarget', 'checkedOn', 'ssl'])
        && item.keys().hasAll(['domain', 'status', 'createdOn'])
        && optionalText(item, 'dnsTarget', 100)
        && (!item.keys().hasAny(['checkedOn']) || dateText(item.checkedOn))
        && (!item.keys().hasAny(['ssl']) || item.ssl in ['pending', 'active'])
        && item.domain is string && item.domain.matches('[a-z0-9]([a-z0-9.-]{0,98}[a-z0-9])?[.][a-z]{2,20}')
        && item.status in ['requested', 'dns-pending', 'verified', 'rejected']
        && dateText(item.createdOn)
        && optText(item, 'note', 200);
    }

    function validDataRequest(item) {
      return item.keys().hasOnly(['kind', 'status', 'note', 'createdOn'])
        && item.keys().hasAll(['kind', 'status', 'createdOn'])
        && item.kind in ['export', 'deletion']
        && item.status in ['requested', 'approved', 'completed', 'held']
        && dateText(item.createdOn)
        && optText(item, 'note', 300);
    }

    function validUsage(item) {
      return item.keys().hasOnly(['students', 'staff', 'classes', 'payments', 'storageMb', 'updatedAt'])
        && (!item.keys().hasAny(['storageMb']) || (intIn(item.storageMb, 0, 100000000)))
        && item.keys().hasAll(['students', 'staff', 'updatedAt'])
        && intIn(item.students, 0, 10000000)
        && intIn(item.staff, 0, 10000000)
        && (!item.keys().hasAny(['classes']) || (intIn(item.classes, 0, 10000000)))
        && (!item.keys().hasAny(['payments']) || (intIn(item.payments, 0, 100000000)))
        && item.updatedAt == request.time;
    }

    function validDrill(item) {
      return item.keys().hasOnly(['date', 'what', 'result', 'minutes'])
        && item.keys().hasAll(['date', 'what', 'result'])
        && dateText(item.date)
        && namedText(item.what, 200)
        && maxText(item.result, 500)
        && (!item.keys().hasAny(['minutes']) || (intIn(item.minutes, 0, 100000)));
    }

    function validStorageRequest(item) {
      return item.keys().hasOnly(['schoolId', 'mb', 'note', 'status', 'createdBy', 'createdOn', 'decidedOn', 'reply'])
        && item.keys().hasAll(['schoolId', 'mb', 'status', 'createdBy', 'createdOn'])
        && item.schoolId is string && item.schoolId.matches('[a-z0-9-]{1,40}')
        && intIn(item.mb, 100, 100000)
        && optText(item, 'note', 300)
        && item.status in ['pending', 'approved', 'rejected']
        && item.createdBy is string && dateText(item.createdOn)
        && (!item.keys().hasAny(['decidedOn']) || dateText(item.decidedOn))
        && optText(item, 'reply', 300);
    }

    function validSupportTicket(item) {
      return item.keys().hasOnly(['schoolId', 'subject', 'body', 'status', 'createdBy', 'createdOn', 'reply'])
        && item.keys().hasAll(['schoolId', 'subject', 'body', 'status', 'createdBy', 'createdOn'])
        && item.schoolId is string && item.schoolId.matches('[a-z0-9-]{1,40}')
        && namedText(item.subject, 120)
        && namedText(item.body, 2000)
        && item.status in ['open', 'answered', 'closed']
        && item.createdBy is string && dateText(item.createdOn)
        && optText(item, 'reply', 2000);
    }

    function validAudit(a) {
      return a.keys().hasOnly(['actor', 'actorEmail', 'action', 'schoolId', 'reason', 'detail', 'at'])
        && a.keys().hasAll(['actor', 'action', 'at'])
        && textLen(a.action, 2, 60) && optText(a, 'actorEmail', 120) && optText(a, 'schoolId', 40)
        && optText(a, 'reason', 300) && optText(a, 'detail', 1500);
    }

    function validGrant(g) {
      return g.keys().hasOnly(['schoolId', 'tier', 'reason', 'createdBy', 'createdAt', 'expiresAt', 'auditId'])
        && g.keys().hasAll(['schoolId', 'tier', 'reason', 'createdBy', 'createdAt', 'expiresAt', 'auditId'])
        && g.schoolId is string && g.schoolId.matches('[a-z0-9-]{1,40}')
        && g.tier in ['standard', 'sensitive']
        && textLen(g.reason, 10, 300)
        && g.auditId is string && g.auditId.matches('A-[A-Za-z0-9-]{4,40}')
        && g.expiresAt is timestamp;
    }

    function validInvoicePayment(p) {
      return p.keys().hasOnly(['kind', 'amount', 'method', 'status', 'reference', 'note', 'by', 'at', 'auditId'])
        && p.keys().hasAll(['kind', 'amount', 'method', 'status', 'by', 'at', 'auditId'])
        && p.kind in ['payment', 'refund']
        && intIn(p.amount, 1, 100000000)
        && p.method in ['cash', 'bank', 'upi', 'cheque', 'gateway']
        && p.status in ['verified', 'failed']
        && (p.status == 'verified' || p.kind == 'payment')
        && optText(p, 'reference', 80) && optText(p, 'note', 200)
        && p.auditId is string && p.auditId.matches('A-[A-Za-z0-9-]{4,40}');
    }

    function validInboxMessage(m) {
      return m.keys().hasOnly(['kind', 'title', 'body', 'at'])
        && m.keys().hasAll(['kind', 'title', 'body', 'at'])
        && m.kind in ['announcement', 'renewal', 'payment', 'maintenance', 'targeted']
        && textLen(m.title, 3, 100) && textLen(m.body, 1, 1000);
    }

    function validMessageLog(m) {
      return m.keys().hasOnly(['kind', 'title', 'body', 'audience', 'recipients', 'by', 'at', 'auditId'])
        && m.keys().hasAll(['kind', 'title', 'body', 'audience', 'recipients', 'by', 'at', 'auditId'])
        && m.kind in ['announcement', 'renewal', 'payment', 'maintenance', 'targeted']
        && textLen(m.title, 3, 100) && textLen(m.body, 1, 1000) && textLen(m.audience, 1, 200)
        && m.recipients is list && m.recipients.size() <= 450
        && m.auditId is string && m.auditId.matches('A-[A-Za-z0-9-]{4,40}');
    }

    function validPlan(p) {
      return p.keys().hasOnly(['name', 'monthlyPrice', 'yearlyPrice', 'setupFee', 'studentLimit', 'staffLimit', 'storageMb', 'features', 'active', 'historyId'])
        && p.keys().hasAll(['name', 'monthlyPrice', 'yearlyPrice', 'setupFee', 'studentLimit', 'staffLimit', 'storageMb', 'active', 'historyId'])
        && namedText(p.name, 60)
        && intIn(p.monthlyPrice, 0, 10000000) && intIn(p.yearlyPrice, 0, 100000000) && intIn(p.setupFee, 0, 10000000)
        && intIn(p.studentLimit, 0, 1000000) && intIn(p.staffLimit, 0, 1000000) && intIn(p.storageMb, 0, 10000000)
        && (!p.keys().hasAny(['features']) || (p.features is list && p.features.size() <= 40))
        && p.active is bool
        && p.historyId is string && p.historyId.matches('H-[A-Za-z0-9-]{4,40}');
    }

    function validPlanHistory(h) {
      return h.keys().hasOnly(['planId', 'by', 'at', 'monthlyPrice', 'yearlyPrice', 'setupFee', 'note'])
        && h.keys().hasAll(['planId', 'by', 'at', 'monthlyPrice', 'yearlyPrice', 'setupFee'])
        && h.planId is string && h.planId.matches('[a-z][a-z0-9-]{1,29}')
        && intIn(h.monthlyPrice, 0, 10000000) && intIn(h.yearlyPrice, 0, 100000000) && intIn(h.setupFee, 0, 10000000)
        && optText(h, 'note', 200);
    }

    function validInvite(item) {
      return item.keys().hasOnly(['schoolId', 'email', 'role', 'status', 'createdBy'])
        && item.keys().hasAll(['schoolId', 'email', 'role', 'status', 'createdBy'])
        && item.schoolId is string && item.schoolId.matches('[a-z0-9-]{1,40}')
        && maxText(item.email, 120) && item.email.matches('[^@ A-Z]+@[^@ A-Z]+')
        && item.role in ['teacher', 'principal', 'owner', 'accountant']
        && item.status in ['pending', 'accepted', 'revoked']
        && item.createdBy is string;
    }

    function validInventoryItem(item) {
      return item.keys().hasOnly(['name', 'category', 'unit', 'quantity', 'minQuantity'])
        && item.keys().hasAll(['name', 'quantity', 'minQuantity'])
        && namedText(item.name, 80)
        && optText(item, 'category', 40)
        && optText(item, 'unit', 20)
        && intIn(item.quantity, 0, 1000000)
        && intIn(item.minQuantity, 0, 1000000);
    }

    function validAlumnus(item) {
      return item.keys().hasOnly(['name', 'passoutYear', 'contact', 'occupation', 'note'])
        && item.keys().hasAll(['name', 'passoutYear'])
        && namedText(item.name, 80)
        && intIn(item.passoutYear, 1950, 2100)
        && optText(item, 'contact', 100)
        && optText(item, 'occupation', 100)
        && optText(item, 'note', 300);
    }

    function validHealthRecord(item) {
      return item.keys().hasOnly(['studentId', 'bloodGroup', 'allergies', 'conditions', 'emergencyContact', 'notes', 'vaccinations', 'lastCheckup', 'nextCheckup'])
        && optionalText(item, 'vaccinations', 200)
        && (!item.keys().hasAny(['lastCheckup']) || dateText(item.lastCheckup))
        && (!item.keys().hasAny(['nextCheckup']) || dateText(item.nextCheckup))
        && item.keys().hasAll(['studentId', 'bloodGroup'])
        && idText(item.studentId)
        && item.bloodGroup in ['', 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']
        && optText(item, 'allergies', 200)
        && optText(item, 'conditions', 200)
        && optText(item, 'emergencyContact', 100)
        && optText(item, 'notes', 300);
    }

    function validLessonPlan(item) {
      return item.keys().hasOnly(['classId', 'subjectId', 'subject', 'date', 'topic', 'objectives', 'createdAt', 'createdBy'])
        && item.keys().hasAll(['classId', 'subjectId', 'subject', 'date', 'topic', 'objectives', 'createdAt', 'createdBy'])
        && idText(item.classId)
        && item.subjectId is string && item.subjectId.matches('[a-z0-9-]{1,30}')
        && textLen(item.subject, 1, 40)
        && dateText(item.date) && item.date >= '2020-01-01'
        && namedText(item.topic, 100)
        && namedText(item.objectives, 1000)
        && dateText(item.createdAt) && item.createdAt >= '2020-01-01'
        && item.createdBy is string;
    }

    function validPtmSlot(item) {
      return item.keys().hasOnly(['classId', 'date', 'time', 'teacher', 'place', 'note'])
        && item.keys().hasAll(['classId', 'date', 'time'])
        && idText(item.classId)
        && dateText(item.date) && item.date >= '2020-01-01'
        && item.time is string && item.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && optText(item, 'teacher', 60)
        && optText(item, 'place', 60)
        && optText(item, 'note', 200);
    }

    function validPayroll(item) {
      return item.keys().hasOnly(['staffUid', 'month', 'basic', 'allowances', 'deductions', 'paidOn', 'note'])
        && item.keys().hasAll(['staffUid', 'month', 'basic', 'allowances', 'deductions'])
        && textLen(item.staffUid, 1, 40)
        && item.month is string && item.month.matches('20[0-9]{2}-(0[1-9]|1[0-2])')
        && intIn(item.basic, 0, 10000000)
        && intIn(item.allowances, 0, 10000000)
        && intIn(item.deductions, 0, 10000000)
        && item.deductions <= item.basic + item.allowances
        && (!item.keys().hasAny(['paidOn']) || (dateText(item.paidOn)))
        && optText(item, 'note', 200);
    }

    function validMessage(item) {
      return item.keys().hasOnly(['studentId', 'subject', 'body', 'createdAt', 'createdBy', 'reply', 'repliedAt', 'mod', 'modNote'])
        && item.keys().hasAll(['studentId', 'subject', 'body', 'createdAt', 'createdBy'])
        && (!item.keys().hasAny(['mod']) || item.mod in ['flagged', 'hidden'])
        && optionalText(item, 'modNote', 200)
        && idText(item.studentId)
        && namedText(item.subject, 100)
        && namedText(item.body, 1000)
        && dateText(item.createdAt) && item.createdAt >= '2020-01-01'
        && item.createdBy is string
        && (!item.keys().hasAny(['reply']) || (namedText(item.reply, 1000)))
        && (!item.keys().hasAny(['repliedAt']) || (dateText(item.repliedAt)));
    }

    function optionalText(item, key, max) {
      return !item.keys().hasAny([key]) || (item[key] is string && item[key].size() <= max);
    }

    function validSite(item) {
      return item.keys().hasOnly(['name', 'tagline', 'about', 'vision', 'mission', 'leadership', 'programmes', 'faculty',
          'facilities', 'news', 'phone', 'email', 'address', 'mapUrl', 'seoTitle', 'seoDesc', 'gallery'])
        && optionalText(item, 'seoTitle', 70) && optionalText(item, 'seoDesc', 160) && optionalText(item, 'gallery', 1500)
        && item.keys().hasAll(['name'])
        && textLen(item.name, 1, 80)
        && optionalText(item, 'tagline', 120) && optionalText(item, 'about', 2000) && optionalText(item, 'vision', 500)
        && optionalText(item, 'mission', 500) && optionalText(item, 'leadership', 1000) && optionalText(item, 'programmes', 2000)
        && optionalText(item, 'faculty', 2000) && optionalText(item, 'facilities', 1500) && optionalText(item, 'news', 1500)
        && optionalText(item, 'phone', 30) && optionalText(item, 'email', 100) && optionalText(item, 'address', 200)
        && (!item.keys().hasAny(['mapUrl']) || (maxText(item.mapUrl, 600)
          && item.mapUrl.matches('(https://www\\.google\\.com/maps/embed\\?[^ ]*)?')));
    }

    function fieldSlot(item, key) {
      return !item.keys().hasAny([key]) || (item[key] is string && item[key].size() <= 250
        && item[key].matches('[^|]{1,60}\\|(text|number|date|textarea|select)\\|[01](\\|[^|]{1,150})?'));
    }

    function validSiteExtras(item) {
      return item.keys().hasOnly(['theme', 'tv', 'tvPrev', 'f1', 'f2', 'f3', 'f4', 'f5', 'f6'])
        && (!item.keys().hasAny(['tv']) || (intIn(item.tv, 1, 20)))
        && (!item.keys().hasAny(['tvPrev']) || (item.keys().hasAny(['tv']) && intIn(item.tvPrev, 1, 20)))
        && (!item.keys().hasAny(['theme']) || (item.theme is string && item.theme.matches('mk-[a-z0-9]{3,12}')) || item.theme in ['classic', 'royal', 'emerald', 'crimson', 'midnight', 'saffron', 'ocean', 'slate', 'teal', 'maroon', 'indigo', 'forest', 'sunrise', 'rose', 'charcoal', 'sky',
          'obsidian', 'champagne', 'sapphire', 'emerald-noir', 'ruby', 'rose-gold', 'sandstone', 'lavender', 'sage', 'blush', 'pearl', 'platinum', 'copper', 'abyss', 'amethyst', 'bordeaux', 'olive', 'denim', 'mocha', 'aurora'])
        && fieldSlot(item, 'f1') && fieldSlot(item, 'f2') && fieldSlot(item, 'f3')
        && fieldSlot(item, 'f4') && fieldSlot(item, 'f5') && fieldSlot(item, 'f6');
    }

    // A school may move to any template version up to the newest one the platform has published.
    function templateAllowed(item) {
      return !item.keys().hasAny(['tv'])
        || item.tv <= (exists(/databases/$(database)/documents/platformConfig/templates)
          ? get(/databases/$(database)/documents/platformConfig/templates).data.latest : 1);
    }

    function validTemplateConfig(item) {
      return item.keys().hasOnly(['latest', 'notes']) && item.keys().hasAll(['latest'])
        && intIn(item.latest, 1, 20)
        && optionalText(item, 'notes', 300);
    }

    function validStorageRecord(item) {
      return item.keys().hasOnly(['name', 'kind', 'sizeKb', 'date', 'note'])
        && item.keys().hasAll(['name', 'kind', 'sizeKb', 'date'])
        && namedText(item.name, 100)
        && item.kind in ['document', 'photo', 'report', 'backup', 'other']
        && intIn(item.sizeKb, 0, 5000000)
        && dateText(item.date) && item.date >= '2020-01-01'
        && optionalText(item, 'note', 200);
    }

    function validImage(item, key) {
      return item.keys().hasOnly([key]) && item.keys().hasAll([key])
        && item[key] is string && item[key].size() <= 40000
        && item[key].matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
    }

    function validStudentHistory(item) {
      return item.keys().hasOnly(['studentId', 'at', 'by', 'summary']) && item.keys().hasAll(['studentId', 'at', 'by', 'summary'])
        && idText(item.studentId)
        && item.at is string && item.at.matches('20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9:.]{8,13}Z')
        && maxText(item.by, 128)
        && textLen(item.summary, 1, 500);
    }

    function validPreferences(item) {
      return item.keys().hasOnly(['workingDays', 'startTime', 'endTime', 'lowAttendance', 'terms'])
        && item.keys().hasAll(['workingDays', 'startTime', 'endTime', 'lowAttendance'])
        && item.workingDays is string && item.workingDays.matches('[1-7]{1,7}')
        && item.startTime is string && item.startTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && item.endTime is string && item.endTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && item.startTime < item.endTime
        && intIn(item.lowAttendance, 1, 100)
        && optionalText(item, 'terms', 100);
    }

    function validEnquiry(item) {
      return item.keys().hasOnly(['studentName', 'classApplying', 'guardianName', 'phone', 'email', 'message', 'createdAt', 'status', 'note',
          'a1', 'a2', 'a3', 'a4', 'a5', 'a6'])
        && item.keys().hasAll(['studentName', 'classApplying', 'guardianName', 'phone', 'createdAt', 'status'])
        && namedText(item.studentName, 80)
        && namedText(item.classApplying, 40)
        && namedText(item.guardianName, 80)
        && item.phone is string && item.phone.matches('[0-9+() -]{6,20}')
        && optionalText(item, 'email', 100) && optionalText(item, 'message', 500) && optionalText(item, 'note', 300)
        && optionalText(item, 'a1', 200) && optionalText(item, 'a2', 200) && optionalText(item, 'a3', 200)
        && optionalText(item, 'a4', 200) && optionalText(item, 'a5', 200) && optionalText(item, 'a6', 200)
        && dateText(item.createdAt) && item.createdAt >= '2020-01-01'
        && item.status in ['new', 'contacted', 'interview', 'offered', 'admitted', 'rejected'];
    }

    function validEventReg(item) {
      return item.keys().hasOnly(['eventId', 'eventTitle', 'studentId', 'registeredOn', 'createdBy'])
        && item.keys().hasAll(['eventId', 'eventTitle', 'studentId', 'registeredOn', 'createdBy'])
        && item.eventId is string && item.eventId.matches('[A-Za-z0-9-]{1,30}')
        && textLen(item.eventTitle, 1, 100)
        && idText(item.studentId)
        && dateText(item.registeredOn)
        && item.createdBy is string;
    }

    function validSubmission(item) {
      return item.keys().hasOnly(['homeworkId', 'homeworkTitle', 'studentId', 'studentName', 'classId', 'answer', 'submittedOn', 'createdBy', 'feedback', 'feedbackAt'])
        && item.keys().hasAll(['homeworkId', 'homeworkTitle', 'studentId', 'studentName', 'classId', 'answer', 'submittedOn', 'createdBy'])
        && item.homeworkId is string && item.homeworkId.matches('[A-Za-z0-9-]{1,30}')
        && textLen(item.homeworkTitle, 1, 100)
        && idText(item.studentId)
        && textLen(item.studentName, 1, 80)
        && idText(item.classId)
        && namedText(item.answer, 2000)
        && dateText(item.submittedOn)
        && item.createdBy is string
        && optionalText(item, 'feedback', 500)
        && (!item.keys().hasAny(['feedbackAt']) || (dateText(item.feedbackAt)));
    }

    function validAssessment(item) {
      return item.keys().hasOnly(['classId', 'subjectId', 'subject', 'title', 'date', 'maxMarks', 'createdBy'])
        && item.keys().hasAll(['classId', 'subjectId', 'subject', 'title', 'date', 'maxMarks', 'createdBy'])
        && idText(item.classId)
        && item.subjectId is string && item.subjectId.matches('[a-z0-9-]{1,30}')
        && textLen(item.subject, 1, 40)
        && namedText(item.title, 100)
        && dateText(item.date) && item.date >= '2020-01-01'
        && intIn(item.maxMarks, 1, 1000)
        && item.createdBy is string;
    }

    function validScore(item) {
      return item.keys().hasOnly(['assessmentId', 'assessmentTitle', 'subject', 'subjectId', 'date', 'studentId', 'classId', 'yearId', 'score', 'maxMarks', 'createdBy'])
        && item.keys().hasAll(['assessmentId', 'assessmentTitle', 'subject', 'subjectId', 'date', 'studentId', 'classId', 'yearId', 'score', 'maxMarks', 'createdBy'])
        && item.assessmentId is string && item.assessmentId.matches('[A-Za-z0-9-]{1,30}')
        && textLen(item.assessmentTitle, 1, 100)
        && textLen(item.subject, 1, 40)
        && item.subjectId is string && item.subjectId.matches('[a-z0-9-]{1,30}')
        && dateText(item.date)
        && idText(item.studentId)
        && idText(item.classId)
        && idText(item.yearId)
        && intIn(item.score, 0, 1000)
        && intIn(item.maxMarks, 1, 1000)
        && item.createdBy is string;
    }

    function validFamilyAccess(item) {
      return item.keys().hasOnly(['studentId', 'relation', 'active', 'extraStudentIds', 'extraClassIds'])
        && item.keys().hasAll(['studentId', 'relation', 'active'])
        && idText(item.studentId)
        && item.relation in ['student', 'parent'] && item.active is bool
        && (!item.keys().hasAny(['extraStudentIds']) || (item.extraStudentIds is list && item.extraStudentIds.size() <= 4
          && item.relation == 'parent'))
        && (!item.keys().hasAny(['extraClassIds']) || (item.extraClassIds is list && item.extraClassIds.size() <= 4
          && item.keys().hasAny(['extraStudentIds'])));
    }

    function validExam(item) {
      return item.keys().hasOnly(['yearId', 'classId', 'subjectId', 'examKey', 'name', 'maxMarks', 'passMarks', 'status', 'approvedBy', 'published'])
        && (!item.keys().hasAny(['passMarks']) || (intMin(item.passMarks, 0) && item.passMarks <= item.maxMarks))
        && item.keys().hasAll(['yearId', 'classId', 'subjectId', 'examKey', 'name', 'maxMarks', 'status'])
        && idText(item.yearId)
        && idText(item.classId)
        && item.subjectId is string && item.subjectId.matches('[a-z0-9-]{1,30}')
        && idText(item.examKey)
        && namedText(item.name, 60)
        && intIn(item.maxMarks, 1, 1000)
        && item.status in ['open', 'locked', 'approved']
        && ((item.status == 'approved')
          ? (item.keys().hasAll(['approvedBy']) && item.approvedBy == request.auth.uid)
          : !item.keys().hasAny(['approvedBy']))
        && (!item.keys().hasAny(['published']) || (item.status == 'approved' && item.published == true));
    }

    function validStudentRecord(student) {
      return student.keys().hasOnly(['admissionNo', 'name', 'guardianName', 'guardianPhone', 'status', 'dob', 'address',
          'gender', 'motherName', 'previousSchool', 'emergencyPhone', 'guardianEmail', 'tcNo', 'docsReceived'])
        && student.keys().hasAll(['admissionNo', 'name', 'guardianName', 'guardianPhone', 'status'])
        && (!student.keys().hasAny(['dob']) || (dateText(student.dob)))
        && optText(student, 'address', 200)
        && (!student.keys().hasAny(['gender']) || student.gender in ['male', 'female', 'other'])
        && optText(student, 'motherName', 120)
        && optText(student, 'previousSchool', 120)
        && (!student.keys().hasAny(['emergencyPhone']) || (student.emergencyPhone is string && student.emergencyPhone.matches('[0-9+() -]{0,20}')))
        && optText(student, 'guardianEmail', 100)
        && optText(student, 'tcNo', 40)
        && (!student.keys().hasAny(['docsReceived']) || (student.docsReceived is list && student.docsReceived.size() <= 8
          && student.docsReceived.hasOnly(['birth', 'tc', 'marksheet', 'aadhaar', 'photos', 'address', 'medical', 'other'])))
        && student.admissionNo is string && student.admissionNo.matches('[A-Za-z0-9-]{1,20}')
        && namedText(student.name, 120)
        && maxText(student.guardianName, 120)
        && student.guardianName.matches('.*[^[:space:]].*')
        && student.guardianPhone is string && student.guardianPhone.matches('[0-9+() -]{0,20}')
        && student.status in ['active', 'inactive'];
    }

    function validEnrollment(item) {
      return item.keys().hasOnly(['yearId', 'studentId', 'classId', 'sectionId', 'rollNo'])
        && item.keys().hasAll(['yearId', 'studentId', 'classId', 'sectionId', 'rollNo'])
        && idText(item.yearId)
        && idText(item.studentId)
        && idText(item.classId)
        && item.sectionId is string && item.sectionId.matches('[a-z0-9-]{1,31}')
        && intIn(item.rollNo, 1, 999);
    }

    function validRollKey(item) {
      return item.keys().hasOnly(['yearId', 'sectionId', 'rollNo', 'studentId'])
        && item.keys().hasAll(['yearId', 'sectionId', 'rollNo', 'studentId'])
        && idText(item.yearId)
        && item.sectionId is string && item.sectionId.matches('[a-z0-9-]{1,31}')
        && idText(item.studentId)
        && intIn(item.rollNo, 1, 999);
    }

    function validStaff(staff) {
      return staff.keys().hasAll(['name', 'position', 'email'])
        && staff.keys().hasOnly(['name', 'position', 'email'])
        && maxText(staff.name, 120)
        && staff.name.matches('.*[^[:space:]].*')
        && maxText(staff.position, 80)
        && staff.position.matches('.*[^[:space:]].*')
        && maxText(staff.email, 254)
        && (staff.email == '' || staff.email.matches('[^@[:space:]]+@[^@[:space:]]+'));
    }

    function validProfile(profile) {
      return maxText(profile.name, 120)
        && profile.name.matches('.*[^[:space:]].*')
        && maxText(profile.contactEmail, 254)
        && (profile.contactEmail == '' || profile.contactEmail.matches('[^@[:space:]]+@[^@[:space:]]+'))
        && maxText(profile.phone, 40)
        && maxText(profile.address, 500);
    }
  }
}
// Published 2026-11-21 evening.
