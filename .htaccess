AddType text/javascript .mjs
AddType application/manifest+json .webmanifest
RewriteEngine On
RewriteRule ^public/?$ / [R=302,L]
# Marketing website at the front; the school app lives at /app.
# A school's own address (any host other than AZIZ's own) opens that school's public page at the front door.
RewriteCond %{HTTP_HOST} !^(www\.)?azizschoolmanagement\.plateria\.in$ [NC]
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^$ public/school.html [L]
RewriteRule ^$ public/site/index.html [L]
RewriteRule ^app/$ /app [R=301,L]
RewriteRule ^app$ public/index.html [L]
RewriteRule ^(features|pricing|about|contact|security|privacy|terms)/?$ public/site/$1.html [L]
RewriteRule ^(site\.css|site\.js)$ public/site/$1 [L]
RewriteRule ^(sign-in\.css|sign-in\.mjs|firebase-client\.mjs|school\.mjs|platform\.mjs|ui\.mjs|i18n\.mjs|sw\.js|manifest\.webmanifest|icon-192\.png|icon-512\.png)$ public/$1 [L]
RewriteRule ^(school)(\.html)?$ public/school.html [L]
RewriteRule ^(robots\.txt|sitemap\.xml)$ public/$1 [L]
